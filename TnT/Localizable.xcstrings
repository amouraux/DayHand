    "Each ticked word becomes a project and is removed from the start of those titles. A new project takes the category most of its cards have.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes angehakte Wort wird ein Projekt und verschwindet vom Anfang dieser Titel. Ein neues Projekt erhält die Kategorie, die die meisten seiner Karten haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada palabra marcada se convierte en un proyecto y desaparece del principio de esos títulos. Un proyecto nuevo toma la categoría que tienen la mayoría de sus tarjetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque mot coché devient un projet et disparaît du début de ces titres. Un nouveau projet prend la catégorie majoritaire de ses cartes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni parola spuntata diventa un progetto e sparisce dall’inizio di quei titoli. Un nuovo progetto prende la categoria della maggior parte delle sue carte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk aangevinkt woord wordt een project en verdwijnt uit het begin van die titels. Een nieuw project krijgt de categorie die de meeste van zijn kaarten hebben."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada palavra assinalada torna-se um projeto e desaparece do início desses títulos. Um projeto novo fica com a categoria da maioria dos seus cartões."
          }
        }
      }
    },
