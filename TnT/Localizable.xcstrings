    "Renames “%@” on every project in it. Using another group’s name joins the two.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benennt „%@“ in all seinen Projekten um. Der Name einer anderen Gruppe führt beide zusammen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renombra «%@» en todos sus proyectos. Usar el nombre de otro grupo une los dos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renomme « %@ » sur tous ses projets. Reprendre le nom d’un autre groupe fusionne les deux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinomina «%@» su tutti i suoi progetti. Usare il nome di un altro gruppo li unisce."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hernoemt “%@” op al zijn projecten. De naam van een andere groep gebruiken voegt beide samen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda o nome de «%@» em todos os seus projetos. Usar o nome de outro grupo junta os dois."
          }
        }
      }
    },
