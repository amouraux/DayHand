    "Put one file in iCloud Drive and point every device at it. iCloud syncs the file, so no paid developer account is needed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie eine Datei in iCloud Drive und richten Sie jedes Gerät darauf aus. iCloud synchronisiert die Datei, ein bezahlter Entwickleraccount ist nicht nötig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon un archivo en iCloud Drive y apunta ahí cada dispositivo. iCloud sincroniza el archivo, así que no hace falta una cuenta de desarrollador de pago."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez un fichier dans iCloud Drive et pointez chaque appareil dessus. iCloud synchronise le fichier : aucun compte développeur payant n’est nécessaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti un file in iCloud Drive e fai puntare lì ogni dispositivo. iCloud sincronizza il file, quindi non serve un account sviluppatore a pagamento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet één bestand in iCloud Drive en laat elk apparaat ernaar wijzen. iCloud synchroniseert het bestand, dus een betaald ontwikkelaarsaccount is niet nodig."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque um ficheiro no iCloud Drive e aponte cada dispositivo para ele. O iCloud sincroniza o ficheiro, pelo que não é preciso uma conta de programador paga."
          }
        }
      }
    },
    "Read how this works": {
      "comment": "Starter card, already completed",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lesen, wie das funktioniert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee cómo funciona"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire comment ça marche"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi come funziona"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees hoe dit werkt"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ler como isto funciona"
          }
        }
      }
    },
    "Removes every card on this device. Categories are kept. If a sync file is in use, the deletion reaches your other devices too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt jede Karte auf diesem Gerät. Kategorien bleiben erhalten. Wird eine Sync-Datei verwendet, erreicht die Löschung auch Ihre anderen Geräte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina todas las tarjetas de este dispositivo. Las categorías se conservan. Si se usa un archivo de sincronización, la eliminación llega también a tus otros dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime toutes les cartes de cet appareil. Les catégories sont conservées. Si un fichier de synchronisation est utilisé, la suppression touche aussi vos autres appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove ogni carta su questo dispositivo. Le categorie restano. Se è in uso un file di sincronizzazione, l’eliminazione raggiunge anche gli altri dispositivi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert elke kaart op dit apparaat. Categorieën blijven behouden. Bij een synchronisatiebestand bereikt de verwijdering ook je andere apparaten."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove todos os cartões neste dispositivo. As categorias são mantidas. Se estiver em uso um ficheiro de sincronização, a eliminação chega também aos seus outros dispositivos."
          }
        }
      }
    },
