          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cópias de segurança"
          }
        }
      }
    },
    "Both devices read and write this one file. Changes are merged, so edits made on either side while offline are kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Geräte lesen und schreiben diese eine Datei. Änderungen werden zusammengeführt, sodass Offline-Bearbeitungen auf beiden Seiten erhalten bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos dispositivos leen y escriben este mismo archivo. Los cambios se combinan, así que las ediciones hechas sin conexión en cualquiera de los dos se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux appareils lisent et écrivent ce même fichier. Les modifications sont fusionnées : celles faites hors ligne d’un côté comme de l’autre sont conservées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrambi i dispositivi leggono e scrivono questo stesso file. Le modifiche vengono unite, quindi le modifiche fatte offline da una parte o dall’altra si conservano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide apparaten lezen en schrijven dit ene bestand. Wijzigingen worden samengevoegd, dus offline bewerkingen aan beide kanten blijven behouden."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos os dispositivos leem e escrevem este mesmo ficheiro. As alterações são combinadas, pelo que as edições feitas offline de qualquer lado são mantidas."
          }
        }
      }
    },
