    "The %lld cards here will be replaced by the %lld in this backup. Categories and projects come back too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die %lld Karten hier werden durch die %lld dieser Sicherung ersetzt. Kategorien und Projekte kommen ebenfalls zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The %1$lld cards here will be replaced by the %2$lld in this backup. Categories and projects come back too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las %lld tarjetas de aquí se reemplazarán por las %lld de esta copia. Las categorías y los proyectos también vuelven."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %lld cartes présentes seront remplacées par les %lld de cette sauvegarde. Les catégories et les projets reviennent aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le %lld carte qui saranno sostituite dalle %lld di questo backup. Tornano anche categorie e progetti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De %lld kaarten hier worden vervangen door de %lld in deze back-up. Categorieën en projecten komen ook terug."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os %lld cartões daqui serão substituídos pelos %lld desta cópia. As categorias e os projetos também voltam."
          }
        }
      }
    },
