    "Archived projects keep their cards but are no longer suggested. Typing one’s name brings it back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivierte Projekte behalten ihre Karten, werden aber nicht mehr vorgeschlagen. Den Namen zu tippen holt sie zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los proyectos archivados conservan sus tarjetas pero ya no se sugieren. Escribir su nombre los recupera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les projets archivés gardent leurs cartes mais ne sont plus proposés. Taper leur nom les réactive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I progetti archiviati mantengono le loro carte ma non vengono più suggeriti. Digitarne il nome li riporta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gearchiveerde projecten behouden hun kaarten maar worden niet meer voorgesteld. Typ de naam om er weer een te gebruiken."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os projetos arquivados mantêm os seus cartões mas deixam de ser sugeridos. Escrever o nome traz um de volta."
          }
        }
      }
    },
    "Backups": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicherungen"
          }
        },
        "es": {
