    "No backups yet. One is taken automatically each day the app is opened.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Sicherungen. An jedem Tag, an dem die App geöffnet wird, entsteht automatisch eine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay copias. Se hace una automáticamente cada día que se abre la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune sauvegarde pour l’instant. Une est prise automatiquement chaque jour où l’app est ouverte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun backup. Ne viene creato uno in automatico ogni giorno in cui l’app viene aperta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen back-ups. Er wordt er automatisch één gemaakt op elke dag dat de app wordt geopend."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem cópias. É feita uma automaticamente em cada dia em que a app é aberta."
          }
        }
      }
    },
