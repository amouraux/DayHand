    "Merging keeps both sides. Replacing discards the %lld cards here and takes the file's.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammenführen behält beide Seiten. Ersetzen verwirft die %lld Karten hier und übernimmt die der Datei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinar conserva ambos lados. Reemplazar descarta las %lld tarjetas de aquí y toma las del archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fusionner garde les deux côtés. Remplacer écarte les %lld cartes présentes et prend celles du fichier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unire mantiene entrambe le parti. Sostituire scarta le %lld carte qui e prende quelle del file."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samenvoegen behoudt beide kanten. Vervangen gooit de %lld kaarten hier weg en neemt die van het bestand."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinar mantém os dois lados. Substituir descarta os %lld cartões daqui e fica com os do ficheiro."
          }
        }
      }
    },
