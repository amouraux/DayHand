    "Cards in Later start from the day after tomorrow.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Später beginnen Karten ab übermorgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Más tarde, las tarjetas empiezan pasado mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Plus tard, les cartes commencent après-demain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Più tardi le carte partono da dopodomani."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In Later beginnen kaarten vanaf overmorgen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Mais tarde, os cartões começam depois de amanhã."
          }
        }
      }
    },
    "Cards show the icon only. The label names the category here and for VoiceOver.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karten zeigen nur das Symbol. Der Name gilt hier und für VoiceOver."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tarjetas solo muestran el icono. El nombre sirve aquí y para VoiceOver."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cartes n’affichent que l’icône. Le nom sert ici et pour VoiceOver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le carte mostrano solo l’icona. Il nome vale qui e per VoiceOver."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaarten tonen alleen het symbool. De naam geldt hier en voor VoiceOver."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os cartões mostram apenas o ícone. O nome serve aqui e para o VoiceOver."
          }
        }
      }
    },
    "Cards written as “TRIP book flights” can become “book flights” in project TRIP. You choose which words to convert.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karten wie „REISE Flüge buchen“ können zu „Flüge buchen“ im Projekt REISE werden. Sie wählen, welche Wörter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tarjetas escritas como «VIAJE reservar vuelos» pueden convertirse en «reservar vuelos» dentro del proyecto VIAJE. Tú eliges qué palabras convertir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cartes écrites « VOYAGE réserver les vols » peuvent devenir « réserver les vols » dans le projet VOYAGE. Vous choisissez les mots à convertir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le carte scritte come «VIAGGIO prenotare i voli» possono diventare «prenotare i voli» nel progetto VIAGGIO. Scegli tu quali parole convertire."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaarten als “REIS vluchten boeken” kunnen “vluchten boeken” worden in project REIS. Jij kiest welke woorden."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os cartões escritos como «VIAGEM reservar voos» podem tornar-se «reservar voos» no projeto VIAGEM. Escolhe que palavras converter."
          }
        }
      }
    },
