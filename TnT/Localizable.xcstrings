    "Taken automatically once a day: the most recent, the day before, and one from about a week ago. Tap one to restore it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch einmal täglich: die neueste, die vom Vortag und eine von vor etwa einer Woche. Zum Wiederherstellen antippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hace automáticamente una vez al día: la más reciente, la del día anterior y una de hace una semana. Toca una para restaurarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prise automatiquement une fois par jour : la plus récente, celle de la veille et une d’il y a environ une semaine. Touchez-en une pour la restaurer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eseguito automaticamente una volta al giorno: il più recente, quello del giorno prima e uno di circa una settimana fa. Toccane uno per ripristinarlo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch eenmaal per dag: de meest recente, die van de dag ervoor en één van ongeveer een week geleden. Tik erop om te herstellen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Feita automaticamente uma vez por dia: a mais recente, a do dia anterior e uma de há cerca de uma semana. Toque numa para a restaurar."
          }
        }
      }
    },
    "Tap + to drop a card into your inbox.": {
