    "Importing can either add to what is here or replace it. Cards are matched by id; categories and projects by name.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Import kann ergänzen oder ersetzen. Karten werden per ID erkannt, Kategorien und Projekte per Name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La importación puede añadir a lo que hay o reemplazarlo. Las tarjetas se reconocen por identificador; las categorías y los proyectos por nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’import peut compléter ce qui est ici ou le remplacer. Les cartes sont reconnues par identifiant ; les catégories et les projets par nom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’importazione può aggiungersi a ciò che c’è o sostituirlo. Le carte sono riconosciute dall’identificativo; categorie e progetti dal nome."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importeren kan aanvullen of vervangen. Kaarten worden op id herkend; categorieën en projecten op naam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A importação pode juntar-se ao que existe ou substituí-lo. Os cartões são reconhecidos pelo id; categorias e projetos pelo nome."
          }
        }
      }
    },
