    "It is already past %@ today, so no notification will come. The task shows as due now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist heute schon nach %@, deshalb kommt keine Benachrichtigung. Die Aufgabe erscheint sofort als fällig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya han pasado las %@ de hoy, así que no llegará ninguna notificación. La tarea aparece como pendiente desde ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est déjà plus de %@ aujourd’hui, donc aucune notification ne viendra. La tâche apparaît comme due dès maintenant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono già passate le %@ di oggi, quindi non arriverà nessuna notifica. L’attività risulta in scadenza da subito."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is vandaag al na %@, dus er komt geen melding. De taak wordt meteen als actueel getoond."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já passaram as %@ de hoje, por isso não chegará nenhuma notificação. A tarefa aparece como devida desde já."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の%@はすでに過ぎているため、通知は届きません。タスクは今すぐ期日として表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já passou das %@ de hoje, então nenhuma notificação virá. A tarefa aparece como vencida agora."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 %@은(는) 이미 지났으므로 알림이 오지 않습니다. 할 일은 지금 기한이 된 것으로 표시됩니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klockan %@ idag har redan passerat, så ingen avisering kommer. Uppgiften visas som förfallen nu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klokken %@ i dag er allerede passeret, så der kommer ingen besked. Opgaven vises som forfalden nu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klokken %@ i dag er allerede passert, så det kommer ikke noe varsel. Oppgaven vises som forfalt nå."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän päivän kello %@ on jo mennyt, joten ilmoitusta ei tule. Tehtävä näkyy erääntyneenä nyt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Godzina %@ dzisiaj już minęła, więc powiadomienie nie nadejdzie. Zadanie jest pokazane jako wymagalne teraz."
          }
        }
      }
    },
