    "Nothing rolls over: tasks stay where you put them": {
      "comment": "Starter task",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts rutscht weiter: Aufgaben bleiben, wo Sie sie ablegen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada se traslada: las tareas se quedan donde las pones"
          }
