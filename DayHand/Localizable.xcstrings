        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjennomgangen av oppgaver er ferdig. Gå tilbake til prosjektoversikten for å avgjøre om det er en tydelig vei videre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehtävien läpikäynti on valmis. Palaa projektin yleiskatsaukseen ja päätä, onko eteenpäin selvä tie."
