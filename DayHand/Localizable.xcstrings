    "Everything you have stays yours either way: your tasks, backups and exports always hold all of it." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt, hvad du har, forbliver dit under alle omstændigheder: dine opgaver, backups og eksporter indeholder altid det hele."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In jedem Fall bleibt alles deins: Deine Aufgaben, Sicherungen und Exporte enthalten immer alles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo tuyo sigue siendo tuyo en cualquier caso: tus tareas, copias de seguridad y exportaciones siempre lo contienen todo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki, mitä sinulla on, pysyy sinun kummassakin tapauksessa: tehtäväsi, varmuuskopiosi ja vientisi sisältävät aina kaiken."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans tous les cas, tout reste à vous : vos tâches, sauvegardes et exports contiennent toujours tout."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In ogni caso tutto resta tuo: le attività, i backup e le esportazioni contengono sempre tutto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どちらの場合でも、すべてあなたのものです。タスク、バックアップ、書き出しには、常にすべてが含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어느 쪽이든 모든 것은 여전히 여러분의 것입니다. 할 일, 백업, 내보내기에는 항상 모든 내용이 담깁니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt du har, forblir ditt uansett: oppgavene, sikkerhetskopiene og eksportene dine inneholder alltid alt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe dan ook blijft alles van jou: je taken, back-ups en exports bevatten altijd alles."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak czy inaczej wszystko, co masz, pozostaje Twoje: zadania, kopie zapasowe i eksporty zawsze zawierają wszystko."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em qualquer dos casos, tudo continua sendo seu: suas tarefas, backups e exportações sempre contêm tudo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
