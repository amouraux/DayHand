    "Tasks you kept in Inbox and any new arrivals are still there. Nothing moves unless you choose.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches conservées et les nouvelles sont toujours dans la boîte de réception. Rien ne bouge sans votre décision."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaarde en nieuwe taken staan nog in Inbox. Alleen jij bepaalt wat er wordt verplaatst."
