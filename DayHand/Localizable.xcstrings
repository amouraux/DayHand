    "%@’s %lld tasks move to %@, and %@ is removed." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@s %2$lld opgaver flyttes til %3$@, og %4$@ fjernes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die %2$lld Aufgaben von %1$@ wandern zu %3$@, und %4$@ wird entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@’s %2$lld tasks move to %3$@, and %4$@ is removed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las %2$lld tareas de %1$@ pasan a %3$@, y %4$@ se elimina."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projektin %1$@ %2$lld tehtävää siirretään kohteeseen %3$@, ja %4$@ poistetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
