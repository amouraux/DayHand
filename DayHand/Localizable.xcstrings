        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una destinazione di importazione è cambiata. Torna indietro e sceglila di nuovo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um destino de importação foi alterado. Volte atrás e escolha-o novamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込み先が変更されました。戻って選び直してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um destino de importação foi alterado. Volte e escolha-o novamente."
          }
        }
      }
    },
    "A project with that name already exists. Choose it explicitly or use another name.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A project with that name already exists. Choose it explicitly or use another name."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un projet porte déjà ce nom. Sélectionnez-le explicitement ou utilisez un autre nom."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er bestaat al een project met die naam. Kies het expliciet of gebruik een andere naam."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Projekt mit diesem Namen existiert bereits. Wähle es ausdrücklich aus oder verwende einen anderen Namen."
          }
        },
        "es": {
