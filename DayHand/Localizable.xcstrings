    "Your full review is finished. Tasks you kept remain in their stacks. New arrivals can be reviewed in the next pass.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre révision complète est terminée. Les tâches conservées restent dans leurs piles. Les nouvelles pourront être examinées au prochain passage."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je volledige ronde is afgerond. Behouden taken blijven in hun stapels. Nieuwe taken komen in de volgende ronde aan bod."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine vollständige Durchsicht ist abgeschlossen. Behaltene Aufgaben bleiben in ihren Stapeln. Neue Aufgaben kommen beim nächsten Mal dran."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu revisión completa ha terminado. Las tareas conservadas permanecen en sus pilas. Las nuevas podrán revisarse en la próxima ronda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La revisione completa è terminata. Le attività mantenute restano nelle loro pile. Le nuove potranno essere riviste al prossimo passaggio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A revisão completa terminou. As tarefas mantidas ficam nas suas pilhas. As novas podem ser revistas na próxima passagem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全体レビューが完了しました。残したタスクはそれぞれのスタックに残ります。新しく届いたタスクは、次回のレビューで見直せます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A revisão completa terminou. As tarefas mantidas ficam em suas pilhas. As novas podem ser revisadas na próxima passagem."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 검토를 마쳤습니다. 유지한 할 일은 각자의 스택에 남습니다. 새로 도착한 할 일은 다음 검토에서 볼 수 있습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din fullständiga granskning är klar. Uppgifter du behöll stannar i sina högar. Nya uppgifter kan granskas i nästa omgång."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din fulde gennemgang er færdig. Opgaver, du beholdt, bliver i deres bunker. Nye opgaver kan gennemgås i næste runde."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den fulle gjennomgangen er ferdig. Oppgaver du beholdt, blir i bunkene sine. Nye oppgaver kan gås gjennom i neste runde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täysi läpikäyntisi on valmis. Säilyttämäsi tehtävät pysyvät pinoissaan. Uudet tehtävät voi käydä läpi seuraavalla kierroksella."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pełny przegląd zakończony. Zadania, które zostawiono, pozostają w swoich stosach. Nowe zadania można przejrzeć w następnym przebiegu."
          }
        }
      }
    },
