    },
    "Allow Reminders access in system settings, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Reminders access in system settings, then try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès aux rappels dans les réglages système, puis réessayez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta toegang tot Herinneringen toe in de systeeminstellingen en probeer het opnieuw."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Zugriff auf Erinnerungen in den Systemeinstellungen und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a Recordatorios en los ajustes del sistema y vuelve a intentarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso ai promemoria nelle impostazioni di sistema, poi riprova."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso aos Lembretes nas definições do sistema e tente novamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定でリマインダーへのアクセスを許可してから、もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso aos Lembretes nos ajustes do sistema e tente novamente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 미리 알림 접근을 허용한 다음 다시 시도하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt åtkomst till Påminnelser i systeminställningarna och försök igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad adgang til Påmindelser i systemindstillingerne, og prøv igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat tilgang til Påminnelser i systeminnstillingene, og prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli pääsy Muistutuksiin järjestelmäasetuksissa ja yritä uudelleen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na dostęp do Przypomnień w ustawieniach systemu i spróbuj ponownie."
          }
        }
      }
    },
    "Reminders could not be read. Please try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders could not be read. Please try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels n’ont pas pu être lus. Réessayez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De herinneringen konden niet worden gelezen. Probeer het opnieuw."
          }
        },
        "de": {
          "stringUnit": {
