    "Am I still waiting, or can this move forward?": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suis-je encore en attente, ou puis-je avancer ?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht ik nog, of kan dit verder?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte ich noch, oder kann es weitergehen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Sigo esperando o puede avanzar?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sto ancora aspettando o posso andare avanti?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda estou à espera ou isto pode avançar?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ待っていますか？それとも先に進められますか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda estou aguardando, ou isso pode avançar?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 기다리고 있나요, 아니면 진행할 수 있나요?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väntar jag fortfarande, eller kan den här gå vidare?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter jeg stadig, eller kan den her komme videre?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter jeg fortsatt, eller kan denne gå videre?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Odotanko vielä, vai voiko tämä edetä?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy nadal czekam, czy to może ruszyć dalej?"
          }
        }
      }
    },
    "All Waiting tasks, including those outside your current filters.": {
