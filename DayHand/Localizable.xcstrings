    "Tasks waiting on someone or something will appear here.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches en attente de quelqu’un ou de quelque chose apparaîtront ici."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taken die op iemand of iets wachten verschijnen hier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben, die auf jemanden oder etwas warten, erscheinen hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí aparecerán las tareas que esperan a alguien o algo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui appariranno le attività in attesa di qualcuno o qualcosa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas à espera de alguém ou de algo aparecerão aqui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰か、または何かを待っているタスクが、ここに表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
