    "Groups gather projects that belong together, such as Grants or Courses." : {
      "comment" : "Explains what a group is, under the New Group field",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupper samler projekter, der hører sammen, for eksempel Legater eller Kurser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gruppen fassen Projekte zusammen, die zusammengehören, etwa Förderungen oder Kurse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los grupos reúnen proyectos que van juntos, como Becas o Cursos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ryhmät kokoavat yhteen kuuluvia projekteja, kuten Apurahat tai Kurssit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les groupes rassemblent des projets qui vont ensemble, comme Subventions ou Cours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I gruppi riuniscono progetti che stanno insieme, come Finanziamenti o Corsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
