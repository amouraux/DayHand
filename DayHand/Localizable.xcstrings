    "%@’s %lld tasks move to %@, and %@ is removed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die %2$lld Aufgaben von %1$@ wandern zu %3$@, und %4$@ wird entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@’s %2$lld tasks move to %3$@, and %4$@ is removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las %2$lld tareas de %1$@ pasan a %3$@, y %4$@ se elimina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %2$lld tâches de %1$@ passent dans %3$@, et %4$@ est supprimé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le %2$lld attività di %1$@ passano a %3$@, e %4$@ viene rimosso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De %2$lld taken van %1$@ gaan naar %3$@, en %4$@ verdwijnt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As %2$lld tarefas de %1$@ passam para %3$@, e %4$@ é removido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の%2$lld件のタスクを%3$@に移動し、%4$@を削除します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As %2$lld tarefas de %1$@ passam para %3$@, e %4$@ é removido."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@의 할 일 %2$lld개를 %3$@(으)로 옮기고 %4$@을(를) 삭제합니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@s %2$lld uppgifter flyttas till %3$@ och %4$@ tas bort."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@s %2$lld opgaver flyttes til %3$@, og %4$@ fjernes."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@s %2$lld oppgaver flyttes til %3$@, og %4$@ fjernes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Projektin %1$@ %2$lld tehtävää siirretään kohteeseen %3$@, ja %4$@ poistetaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld zadań z projektu %1$@ zostanie przeniesionych do %3$@, a %4$@ zostanie usunięty."
          }
        }
      }
    },
