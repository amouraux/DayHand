          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De %1$lld taken hier worden vervangen door de %2$lld in deze back-up. Categorieën en projecten komen ook terug."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As %1$lld tarefas daqui serão substituídas pelas %2$lld desta cópia. As categorias e os projetos também voltam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにある%1$lld件のタスクは、このバックアップの%2$lld件に置き換わります。カテゴリとプロジェクトも元に戻ります。"
