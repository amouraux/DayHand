    "Move it, or keep it where it is.": {
      "comment": "Notification body for a reminder",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschieben Sie sie, oder lassen Sie sie, wo sie ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muévela o déjala donde está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez-la, ou laissez-la où elle est."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spostala, o lasciala dov’è."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verplaats hem, of laat hem staan."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova-o, ou deixe-o onde está."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動するか、そのままにしておきましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova a tarefa ou deixe onde está."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "옮기거나 그대로 두세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytta den eller låt den ligga kvar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyt den, eller lad den blive, hvor den er."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytt den, eller la den bli der den er."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirrä se tai jätä se paikalleen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenieś je albo zostaw tam, gdzie jest."
          }
        }
      }
    },
