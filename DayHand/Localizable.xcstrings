    "The CSV file must use UTF-8 text encoding.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The CSV file must use UTF-8 text encoding."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier CSV doit utiliser l’encodage UTF-8."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het CSV-bestand moet UTF-8-tekstcodering gebruiken."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die CSV-Datei muss die Textkodierung UTF-8 verwenden."
          }
        },
        "es": {
