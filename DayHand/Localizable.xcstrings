    "The free version keeps up to %lld active projects. Your task was added without the project %@. Archive a project you have finished to make room, or unlock DayHand.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kostenlose Version erlaubt bis zu %lld aktive Projekte. Deine Aufgabe wurde ohne das Projekt %@ hinzugefügt. Archiviere ein beendetes Projekt, um Platz zu schaffen, oder schalte DayHand frei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión gratuita admite hasta %lld proyectos activos. Tu tarea se añadió sin el proyecto %@. Archiva un proyecto terminado para hacer sitio, o desbloquea DayHand."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version gratuite permet jusqu’à %lld projets actifs. Votre tâche a été ajoutée sans le projet %@. Archivez un projet terminé pour faire de la place, ou débloquez DayHand."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione gratuita consente fino a %lld progetti attivi. La tua attività è stata aggiunta senza il progetto %@. Archivia un progetto concluso per fare spazio, oppure sblocca DayHand."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gratis versie biedt plaats aan maximaal %lld actieve projecten. Je taak is toegevoegd zonder het project %@. Archiveer een afgerond project om ruimte te maken, of ontgrendel DayHand."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão gratuita permite até %lld projetos ativos. A sua tarefa foi adicionada sem o projeto %@. Arquive um projeto terminado para libertar espaço, ou desbloqueie o DayHand."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料版では、進行中のプロジェクトは%lld件までです。プロジェクト「%@」なしでタスクを追加しました。終えたプロジェクトをアーカイブして空きを作るか、DayHandをアンロックしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão gratuita permite até %lld projetos ativos. Sua tarefa foi adicionada sem o projeto %@. Arquive um projeto concluído para abrir espaço, ou desbloqueie o DayHand."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 버전에서는 진행 중인 프로젝트를 %lld개까지 둘 수 있습니다. 할 일은 프로젝트 %@ 없이 추가되었습니다. 끝난 프로젝트를 보관해 자리를 만들거나 DayHand를 잠금 해제하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kostnadsfria versionen rymmer upp till %lld aktiva projekt. Din uppgift lades till utan projektet %@. Arkivera ett projekt du är klar med för att göra plats, eller lås upp DayHand."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gratis version rummer op til %lld aktive projekter. Din opgave blev tilføjet uden projektet %@. Arkivér et projekt, du er færdig med, for at gøre plads, eller lås DayHand op."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gratis versjonen har plass til opptil %lld aktive prosjekter. Oppgaven din ble lagt til uten prosjektet %@. Arkiver et prosjekt du er ferdig med for å gjøre plass, eller lås opp DayHand."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmaisversiossa voi olla enintään %lld aktiivista projektia. Tehtäväsi lisättiin ilman projektia %@. Arkistoi valmis projekti tehdäksesi tilaa tai avaa DayHand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersja darmowa pozwala na maksymalnie %lld aktywnych projektów. Twoje zadanie dodano bez projektu %@. Zarchiwizuj zakończony projekt, aby zrobić miejsce, albo odblokuj DayHand."
          }
        }
      }
    },
    "The free version keeps up to %lld active projects. Archive a project you have finished to make room, or unlock DayHand.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kostenlose Version erlaubt bis zu %lld aktive Projekte. Archiviere ein beendetes Projekt, um Platz zu schaffen, oder schalte DayHand frei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión gratuita admite hasta %lld proyectos activos. Archiva un proyecto terminado para hacer sitio, o desbloquea DayHand."
