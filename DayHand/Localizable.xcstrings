    "Your choices are saved. Kept tasks and new arrivals can be reviewed in a new pass.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos choix sont enregistrés. Les tâches conservées et les nouvelles pourront être revues lors d’un prochain passage."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je keuzes zijn opgeslagen. Behouden en nieuwe taken komen in een nieuwe ronde aan bod."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Entscheidungen sind gespeichert. Behaltene und neue Aufgaben können erneut durchgesehen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus decisiones están guardadas. Las tareas conservadas y las nuevas pueden revisarse en otra ronda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue scelte sono salvate. Le attività mantenute e quelle nuove potranno essere riviste in un nuovo passaggio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas escolhas foram guardadas. As tarefas mantidas e as novas podem ser revistas numa nova passagem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択内容を保存しました。残したタスクと新しく届いたタスクは、新しいレビューで見直せます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas escolhas foram salvas. As tarefas mantidas e as novas podem ser revisadas em uma nova passagem."
          }
        }
      }
    },
