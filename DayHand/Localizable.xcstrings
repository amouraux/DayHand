            "value": "Neue Aufgaben starten mit dieser Kategorie. An der Aufgabe lässt sie sich weiterhin ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas nuevas empiezan con esta categoría. Puedes cambiarla en la tarea."
