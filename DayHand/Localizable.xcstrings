            "value": "CSV-filen måste använda UTF-8-textkodning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV-filen skal bruge UTF-8-tekstkodning."
          }
        },
        "nb": {
