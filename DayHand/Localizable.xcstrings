    "Decide where each Inbox task belongs, one at a time. You can stop and resume whenever you like." : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beslut, hvor hver opgave i indbakken hører hjemme, én ad gangen. Du kan stoppe og genoptage, når du vil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entscheide für jede Aufgabe im Eingang, wohin sie gehört. Du kannst jederzeit aufhören und fortfahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decide dónde va cada tarea de la bandeja de entrada, una por una. Puedes parar y continuar cuando quieras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päätä, mihin kukin saapuneiden tehtävä kuuluu, yksi kerrallaan. Voit pysähtyä ja jatkaa milloin haluat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décidez où placer chaque tâche de la boîte de réception, une à une. Vous pouvez arrêter et reprendre à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decidi dove va ogni attività nella posta in arrivo, una alla volta. Puoi interrompere e riprendere quando vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インボックスの各タスクをどこに置くか、1つずつ決めていきます。いつでも中断して、再開できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수신함의 할 일을 어디에 둘지 하나씩 정하세요. 언제든 멈췄다가 다시 시작할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestem hvor hver oppgave i innboksen hører hjemme, én om gangen. Du kan stoppe og fortsette når du vil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bepaal één voor één waar elke Inbox-taak thuishoort. Je kunt altijd stoppen en verdergaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdecyduj, gdzie powinno trafić każde zadanie ze skrzynki, po kolei. Możesz przerwać i wrócić, kiedy chcesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decida onde fica cada tarefa da caixa de entrada, uma de cada vez. Você pode parar e retomar quando quiser."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decida onde fica cada tarefa da caixa de entrada, uma de cada vez. Pode parar e retomar quando quiser."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestäm var varje uppgift i inkorgen hör hemma, en i taget. Du kan sluta och återuppta när du vill."
          }
        }
      }
    },
