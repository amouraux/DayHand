    },
    "This is a one-time copy. Later changes in either app are independent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a one-time copy. Later changes in either app are independent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s’agit d’une copie unique. Les modifications ultérieures dans chaque app sont indépendantes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een eenmalige kopie. Latere wijzigingen in beide apps staan los van elkaar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist eine einmalige Kopie. Spätere Änderungen in den beiden Apps sind unabhängig voneinander."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es una copia única. Los cambios posteriores en cada app son independientes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È una copia unica. Le modifiche successive nelle due app sono indipendenti."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma cópia única. As alterações posteriores em cada app são independentes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは1回限りのコピーです。以降の変更は、それぞれのAppで独立します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma cópia única. As alterações posteriores em cada app são independentes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번만 복사됩니다. 이후의 변경 사항은 각 앱에서 별개로 적용됩니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här är en engångskopia. Senare ändringar i någon av apparna är oberoende."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er en engangskopi. Senere ændringer i en af apperne er uafhængige."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er en engangskopi. Senere endringer i en av appene er uavhengige."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä on kertaluontoinen kopio. Myöhemmät muutokset kummassakin sovelluksessa ovat toisistaan riippumattomia."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To jednorazowa kopia. Późniejsze zmiany w którejkolwiek z aplikacji są niezależne."
          }
        }
      }
    },
    "An import destination changed. Go back and choose it again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An import destination changed. Go back and choose it again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une destination d’import a changé. Revenez en arrière et choisissez-la à nouveau."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een importbestemming is gewijzigd. Ga terug en kies deze opnieuw."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Importziel wurde geändert. Gehe zurück und wähle es erneut aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha cambiado un destino de importación. Vuelve atrás y elígelo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una destinazione di importazione è cambiata. Torna indietro e sceglila di nuovo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um destino de importação foi alterado. Volte atrás e escolha-o novamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込み先が変更されました。戻って選び直してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um destino de importação foi alterado. Volte e escolha-o novamente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오기 대상이 변경되었습니다. 뒤로 돌아가 다시 선택하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett importmål ändrades. Gå tillbaka och välj det igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et importmål blev ændret. Gå tilbage, og vælg det igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et importmål ble endret. Gå tilbake og velg det på nytt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuontikohde muuttui. Palaa takaisin ja valitse se uudelleen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel importu został zmieniony. Wróć i wybierz go ponownie."
          }
        }
      }
    },
    "A project with that name already exists. Choose it explicitly or use another name.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A project with that name already exists. Choose it explicitly or use another name."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un projet porte déjà ce nom. Sélectionnez-le explicitement ou utilisez un autre nom."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er bestaat al een project met die naam. Kies het expliciet of gebruik een andere naam."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Projekt mit diesem Namen existiert bereits. Wähle es ausdrücklich aus oder verwende einen anderen Namen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe un proyecto con ese nombre. Selecciónalo expresamente o usa otro nombre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esiste già un progetto con questo nome. Selezionalo esplicitamente o usa un altro nome."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já existe um projeto com esse nome. Selecione-o explicitamente ou use outro nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その名前のプロジェクトはすでにあります。明示的に選ぶか、別の名前を使ってください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já existe um projeto com esse nome. Selecione-o explicitamente ou use outro nome."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 이름의 프로젝트가 이미 있습니다. 직접 선택하거나 다른 이름을 사용하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett projekt med det namnet finns redan. Välj det uttryckligen eller använd ett annat namn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et projekt med det navn findes allerede. Vælg det udtrykkeligt, eller brug et andet navn."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et prosjekt med det navnet finnes allerede. Velg det uttrykkelig, eller bruk et annet navn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Samanniminen projekti on jo olemassa. Valitse se erikseen tai käytä toista nimeä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekt o tej nazwie już istnieje. Wybierz go jawnie lub użyj innej nazwy."
          }
        }
      }
    },
    "A backup could not be saved. Nothing was imported.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A backup could not be saved. Nothing was imported."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde n’a pas pu être enregistrée. Rien n’a été importé."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er kon geen reservekopie worden opgeslagen. Er is niets geïmporteerd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es konnte kein Backup gespeichert werden. Es wurde nichts importiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar una copia de seguridad. No se importó nada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare un backup. Nessuna attività è stata importata."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar uma cópia de segurança. Nada foi importado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップを保存できませんでした。何も読み込まれていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar um backup. Nada foi importado."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업을 저장할 수 없습니다. 아무것도 가져오지 않았습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En säkerhetskopia kunde inte sparas. Inget importerades."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En backup kunne ikke gemmes. Intet blev importeret."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En sikkerhetskopi kunne ikke lagres. Ingenting ble importert."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmuuskopiota ei voitu tallentaa. Mitään ei tuotu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać kopii zapasowej. Nic nie zaimportowano."
          }
        }
      }
    },
    "The imported tasks could not be saved. Nothing was imported.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The imported tasks could not be saved. Nothing was imported."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches importées n’ont pas pu être enregistrées. Rien n’a été importé."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De geïmporteerde taken konden niet worden opgeslagen. Er is niets geïmporteerd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die importierten Aufgaben konnten nicht gespeichert werden. Es wurde nichts importiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar las tareas importadas. No se importó nada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare le attività importate. Nessuna attività è stata importata."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar as tarefas importadas. Nada foi importado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込んだタスクを保存できませんでした。何も読み込まれていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar as tarefas importadas. Nada foi importado."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져온 할 일을 저장할 수 없습니다. 아무것도 가져오지 않았습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De importerade uppgifterna kunde inte sparas. Inget importerades."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De importerede opgaver kunne ikke gemmes. Intet blev importeret."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De importerte oppgavene kunne ikke lagres. Ingenting ble importert."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuotuja tehtäviä ei voitu tallentaa. Mitään ei tuotu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać zaimportowanych zadań. Nic nie zaimportowano."
          }
        }
      }
    },
    "Choose which lists to copy into DayHand. Apple requires full Reminders access to read them. DayHand only reads your reminders and never changes them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which lists to copy into DayHand. Apple requires full Reminders access to read them. DayHand only reads your reminders and never changes them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les listes à copier dans DayHand. Apple exige un accès complet aux rappels pour les lire. DayHand les lit uniquement et ne les modifie jamais."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies welke lijsten je naar DayHand wilt kopiëren. Apple vereist volledige toegang om herinneringen te lezen. DayHand leest je herinneringen alleen en wijzigt ze nooit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Listen aus, die du nach DayHand kopieren möchtest. Apple verlangt zum Lesen vollen Zugriff auf Erinnerungen. DayHand liest sie nur und ändert sie niemals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige las listas que quieres copiar a DayHand. Apple exige acceso completo a Recordatorios para leerlas. DayHand solo lee tus recordatorios y nunca los modifica."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli gli elenchi da copiare in DayHand. Apple richiede l’accesso completo ai promemoria per leggerli. DayHand li legge soltanto e non li modifica mai."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha as listas a copiar para o DayHand. A Apple exige acesso total aos Lembretes para os ler. O DayHand apenas lê os seus lembretes e nunca os altera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DayHandにコピーするリストを選んでください。Appleの仕様上、リマインダーを読み取るにはフルアクセスが必要です。DayHandはリマインダーを読み取るだけで、変更することはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quais listas copiar para o DayHand. A Apple exige acesso total aos Lembretes para lê-los. O DayHand apenas lê seus lembretes e nunca os altera."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DayHand로 복사할 목록을 선택하세요. 미리 알림을 읽으려면 Apple 정책상 전체 접근 권한이 필요합니다. DayHand는 미리 알림을 읽기만 하며 변경하지 않습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj vilka listor som ska kopieras till DayHand. Apple kräver full åtkomst till Påminnelser för att läsa dem. DayHand läser bara dina påminnelser och ändrar dem aldrig."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg, hvilke lister der skal kopieres til DayHand. Apple kræver fuld adgang til Påmindelser for at læse dem. DayHand læser kun dine påmindelser og ændrer dem aldrig."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg hvilke lister som skal kopieres til DayHand. Apple krever full tilgang til Påminnelser for å lese dem. DayHand leser bare påminnelsene dine og endrer dem aldri."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse, mitkä listat kopioidaan DayHandiin. Apple vaatii täyden pääsyn Muistutuksiin niiden lukemiseksi. DayHand vain lukee muistutuksesi eikä muuta niitä koskaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz listy do skopiowania do DayHand. Apple wymaga pełnego dostępu do Przypomnień, aby je odczytać. DayHand tylko czyta Twoje przypomnienia i nigdy ich nie zmienia."
          }
        }
      }
    },
    "Due dates become reminders at 9 a.m. on that day, not deadlines. Original dates and times stay in Notes even when this is off. Dates never move tasks between stacks.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Due dates become reminders at 9 a.m. on that day, not deadlines. Original dates and times stay in Notes even when this is off. Dates never move tasks between stacks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les échéances deviennent des rappels à 9 h ce jour-là, et non des dates limites. Les dates et heures d’origine restent dans Notes même si cette option est désactivée. Les dates ne déplacent jamais les tâches entre piles."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervaldatums worden herinneringen om 9 uur die dag, geen deadlines. Oorspronkelijke datums en tijden blijven in Notities staan, ook als deze optie uitstaat. Datums verplaatsen taken nooit tussen stapels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fälligkeitstage werden zu Erinnerungen um 9 Uhr an diesem Tag, nicht zu Fristen. Ursprüngliche Daten und Uhrzeiten bleiben auch bei deaktivierter Option in den Notizen. Daten verschieben niemals Aufgaben zwischen Stapeln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fechas de vencimiento se convierten en recordatorios a las 9 de ese día, no en fechas límite. Las fechas y horas originales permanecen en Notas aunque desactives esta opción. Las fechas nunca mueven tareas entre pilas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scadenze diventano promemoria alle 9 di quel giorno, non termini di consegna. Date e orari originali restano nelle Note anche disattivando questa opzione. Le date non spostano mai le attività tra le pile."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As datas de vencimento tornam-se lembretes às 9 h desse dia, não prazos. As datas e horas originais ficam nas Notas mesmo com esta opção desativada. As datas nunca movem tarefas entre pilhas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期日は、その日の午前9時のリマインダーになります（期限にはなりません）。このオプションをオフにしても、元の日付と時刻はメモに残ります。日付によってタスクがスタック間を移動することはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As datas de vencimento viram lembretes às 9h desse dia, não prazos. As datas e horas originais ficam em Notas mesmo com esta opção desativada. As datas nunca movem tarefas entre pilhas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기한은 마감일이 아니라 해당 날짜 오전 9시의 미리 알림이 됩니다. 이 옵션을 꺼도 원래의 날짜와 시간은 메모에 남습니다. 날짜가 할 일을 스택 사이로 옮기는 일은 없습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förfallodatum blir påminnelser klockan 09.00 den dagen, inte deadlines. Ursprungliga datum och tider finns kvar i Anteckningar även när det här är av. Datum flyttar aldrig uppgifter mellan högar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forfaldsdatoer bliver til påmindelser kl. 9 den dag, ikke deadlines. De oprindelige datoer og tidspunkter bliver i Noter, selv når dette er slået fra. Datoer flytter aldrig opgaver mellem bunker."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forfallsdatoer blir til påminnelser klokken 09.00 den dagen, ikke frister. De opprinnelige datoene og tidspunktene blir i Notater, selv når dette er slått av. Datoer flytter aldri oppgaver mellom bunker."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Eräpäivistä tulee muistutuksia kello 9.00 kyseisenä päivänä, ei määräaikoja. Alkuperäiset päivämäärät ja kellonajat säilyvät Muistiinpanoissa, vaikka tämä olisi pois päältä. Päivämäärät eivät koskaan siirrä tehtäviä pinojen välillä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminy stają się przypomnieniami o 9:00 danego dnia, a nie terminami ostatecznymi. Pierwotne daty i godziny zostają w Notatkach, nawet gdy ta opcja jest wyłączona. Daty nigdy nie przenoszą zadań między stosami."
          }
        }
      }
    },
    "Recurring reminders are skipped. Subtasks, tags, attachments and smart-list rules are not preserved. Notes, links, dates, locations and priority values are kept as text in Notes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recurring reminders are skipped. Subtasks, tags, attachments and smart-list rules are not preserved. Notes, links, dates, locations and priority values are kept as text in Notes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels récurrents sont ignorés. Les sous-tâches, étiquettes, pièces jointes et règles des listes intelligentes ne sont pas conservés. Notes, liens, dates, lieux et priorités sont conservés comme texte dans Notes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terugkerende herinneringen worden overgeslagen. Subtaken, tags, bijlagen en regels voor slimme lijsten blijven niet behouden. Notities, links, datums, locaties en prioriteiten worden als tekst bewaard in Notities."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederkehrende Erinnerungen werden übersprungen. Unteraufgaben, Tags, Anhänge und Regeln intelligenter Listen werden nicht beibehalten. Notizen, Links, Daten, Orte und Prioritätswerte bleiben als Text in den Notizen erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se omiten los recordatorios recurrentes. No se conservan subtareas, etiquetas, adjuntos ni reglas de listas inteligentes. Las notas, enlaces, fechas, ubicaciones y prioridades se guardan como texto en Notas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria ricorrenti vengono ignorati. Sottoattività, tag, allegati e regole degli elenchi smart non vengono mantenuti. Note, link, date, luoghi e priorità vengono conservati come testo nelle Note."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes recorrentes são ignorados. Subtarefas, etiquetas, anexos e regras de listas inteligentes não são preservados. Notas, ligações, datas, locais e prioridades ficam como texto nas Notas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繰り返しのリマインダーはスキップされます。サブタスク、タグ、添付ファイル、スマートリストの条件は保持されません。メモ、リンク、日付、場所、優先度はメモにテキストとして残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembretes recorrentes são ignorados. Subtarefas, etiquetas, anexos e regras de listas inteligentes não são preservados. Notas, links, datas, locais e prioridades ficam como texto em Notas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반복 미리 알림은 건너뜁니다. 하위 작업, 태그, 첨부 파일, 스마트 목록 규칙은 유지되지 않습니다. 메모, 링크, 날짜, 위치, 우선순위 값은 메모에 텍스트로 남습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återkommande påminnelser hoppas över. Deluppgifter, taggar, bilagor och regler för smarta listor bevaras inte. Anteckningar, länkar, datum, platser och prioritetsvärden behålls som text i Anteckningar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentagne påmindelser springes over. Delopgaver, tags, vedhæftninger og regler for smarte lister bevares ikke. Noter, links, datoer, steder og prioritetsværdier beholdes som tekst i Noter."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjentakende påminnelser hoppes over. Deloppgaver, tagger, vedlegg og regler for smarte lister bevares ikke. Notater, lenker, datoer, steder og prioritetsverdier beholdes som tekst i Notater."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toistuvat muistutukset ohitetaan. Alitehtäviä, tunnisteita, liitteitä ja älylistojen sääntöjä ei säilytetä. Muistiinpanot, linkit, päivämäärät, sijainnit ja tärkeysarvot säilyvät tekstinä Muistiinpanoissa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienia cykliczne są pomijane. Podzadania, tagi, załączniki i reguły list inteligentnych nie są zachowywane. Notatki, linki, daty, lokalizacje i wartości priorytetu zostają jako tekst w Notatkach."
          }
        }
      }
    },
    "A backup is saved before import. Existing DayHand tasks are kept. Repeat imports skip tasks already imported on this device, including ones you deleted. Importing again on another device or after an account reset can create duplicates.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A backup is saved before import. Existing DayHand tasks are kept. Repeat imports skip tasks already imported on this device, including ones you deleted. Importing again on another device or after an account reset can create duplicates."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sauvegarde est créée avant l’import. Les tâches DayHand existantes sont conservées. Les imports suivants ignorent les tâches déjà importées sur cet appareil, même supprimées. Un import sur un autre appareil ou après réinitialisation du compte peut créer des doublons."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor de import wordt een reservekopie opgeslagen. Bestaande DayHand-taken blijven behouden. Herhaalde imports slaan taken over die al op dit apparaat zijn geïmporteerd, ook verwijderde taken. Importeren op een ander apparaat of na het opnieuw instellen van een account kan duplicaten maken."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Import wird ein Backup gespeichert. Bestehende DayHand-Aufgaben bleiben erhalten. Wiederholte Importe überspringen bereits auf diesem Gerät importierte Aufgaben, auch gelöschte. Ein Import auf einem anderen Gerät oder nach dem Zurücksetzen eines Accounts kann Duplikate erzeugen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda una copia de seguridad antes de importar. Las tareas existentes de DayHand se conservan. Las importaciones repetidas omiten las tareas ya importadas en este dispositivo, incluso las eliminadas. Importar en otro dispositivo o tras restablecer una cuenta puede crear duplicados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima dell’importazione viene salvato un backup. Le attività esistenti di DayHand vengono mantenute. Le importazioni ripetute ignorano le attività già importate su questo dispositivo, anche se eliminate. Importare da un altro dispositivo o dopo il ripristino dell’account può creare duplicati."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É guardada uma cópia de segurança antes da importação. As tarefas existentes do DayHand são mantidas. Importações repetidas ignoram tarefas já importadas neste dispositivo, incluindo as eliminadas. Importar noutro dispositivo ou após repor uma conta pode criar duplicados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込む前にバックアップが保存されます。既存のDayHandのタスクはそのまま残ります。繰り返し読み込んでも、このデバイスで読み込み済みのタスク（削除したものを含む）はスキップされます。別のデバイスで読み込んだり、アカウントをリセットしたあとに読み込んだりすると、重複することがあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um backup é salvo antes da importação. As tarefas existentes do DayHand são mantidas. Importações repetidas ignoram tarefas já importadas neste dispositivo, inclusive as excluídas. Importar em outro dispositivo ou depois de redefinir uma conta pode criar duplicatas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오기 전에 백업이 저장됩니다. 기존 DayHand 할 일은 그대로 유지됩니다. 다시 가져와도 이 기기에서 이미 가져온 할 일(삭제한 것 포함)은 건너뜁니다. 다른 기기에서 가져오거나 계정을 초기화한 뒤 가져오면 중복될 수 있습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En säkerhetskopia sparas före importen. Befintliga DayHand-uppgifter behålls. Upprepade importer hoppar över uppgifter som redan importerats på den här enheten, även sådana du tagit bort. Att importera igen på en annan enhet eller efter en kontoåterställning kan ge dubbletter."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gemmes en backup før importen. Eksisterende DayHand-opgaver beholdes. Gentagne importer springer opgaver over, der allerede er importeret på denne enhed, også dem, du har slettet. Import på en anden enhed eller efter en kontonulstilling kan give dubletter."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det lagres en sikkerhetskopi før importen. Eksisterende DayHand-oppgaver beholdes. Gjentatte importer hopper over oppgaver som allerede er importert på denne enheten, også de du har slettet. Import på en annen enhet eller etter en kontonullstilling kan gi duplikater."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmuuskopio tallennetaan ennen tuontia. Olemassa olevat DayHand-tehtävät säilyvät. Toistuvat tuonnit ohittavat tehtävät, jotka on jo tuotu tälle laitteelle, myös poistetut. Tuonti toisella laitteella tai tilin nollauksen jälkeen voi luoda kaksoiskappaleita."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed importem zapisywana jest kopia zapasowa. Istniejące zadania DayHand zostają. Powtórne importy pomijają zadania już zaimportowane na tym urządzeniu, także usunięte. Import na innym urządzeniu lub po zresetowaniu konta może utworzyć duplikaty."
          }
        }
      }
    },
    "Apple Reminders keeps its own alerts. Imported future reminders can also notify you in DayHand. Past dates are marked as answered; their tasks can still appear in Attention.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Reminders keeps its own alerts. Imported future reminders can also notify you in DayHand. Past dates are marked as answered; their tasks can still appear in Attention."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappels d’Apple conserve ses propres alertes. Les rappels futurs importés peuvent aussi vous avertir dans DayHand. Les dates passées sont marquées comme traitées ; leurs tâches peuvent encore apparaître dans Attention."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Herinneringen behoudt zijn eigen meldingen. Geïmporteerde toekomstige herinneringen kunnen ook in DayHand meldingen geven. Verstreken datums worden als afgehandeld gemarkeerd; de taken kunnen nog in Aandacht verschijnen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Erinnerungen behält seine eigenen Hinweise. Importierte zukünftige Erinnerungen können auch in DayHand benachrichtigen. Vergangene Daten werden als beantwortet markiert; ihre Aufgaben können weiterhin unter Aufmerksamkeit erscheinen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordatorios de Apple conserva sus alertas. Los recordatorios futuros importados también pueden avisarte en DayHand. Las fechas pasadas se marcan como atendidas; sus tareas pueden seguir apareciendo en Atención."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Promemoria Apple mantiene i propri avvisi. I promemoria futuri importati possono avvisarti anche in DayHand. Le date passate vengono segnate come gestite; le relative attività possono ancora comparire in Attenzione."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os Lembretes da Apple mantêm os seus alertas. Os lembretes futuros importados também podem notificar no DayHand. As datas passadas são marcadas como tratadas; as tarefas podem continuar a aparecer em Atenção."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーAppは独自の通知を保持します。読み込んだ未来のリマインダーは、DayHandでも通知されることがあります。過去の日付は対応済みとして記録されますが、そのタスクは「注目」に表示されることがあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os Lembretes da Apple mantêm seus próprios alertas. Lembretes futuros importados também podem notificar você no DayHand. Datas passadas são marcadas como tratadas; as tarefas delas ainda podem aparecer em Atenção."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 미리 알림은 자체 알림을 유지합니다. 가져온 미래의 미리 알림은 DayHand에서도 알림을 보낼 수 있습니다. 지난 날짜는 응답한 것으로 표시되지만 해당 할 일은 ‘주의’에 계속 나타날 수 있습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Påminnelser behåller sina egna aviseringar. Importerade framtida påminnelser kan också avisera dig i DayHand. Datum som passerat markeras som besvarade; uppgifterna kan ändå visas i Uppmärksamma."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Påmindelser beholder sine egne beskeder. Importerede fremtidige påmindelser kan også give dig besked i DayHand. Datoer, der er passeret, markeres som besvaret; deres opgaver kan stadig vises under Opmærksomhed."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Påminnelser beholder sine egne varsler. Importerte fremtidige påminnelser kan også varsle deg i DayHand. Datoer som har passert, markeres som besvart; oppgavene deres kan fortsatt vises under Oppmerksomhet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Applen Muistutukset säilyttää omat ilmoituksensa. Tuodut tulevat muistutukset voivat ilmoittaa sinulle myös DayHandissa. Menneet päivämäärät merkitään vastatuiksi; niiden tehtävät voivat silti näkyä kohdassa Huomio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienia Apple zachowują własne alerty. Zaimportowane przyszłe przypomnienia mogą też powiadamiać w DayHand. Minione daty są oznaczane jako obsłużone; ich zadania mogą nadal pojawiać się w Uwadze."
          }
        }
      }
    },
    "Added %lld tasks. Skipped %lld already imported and %lld other tasks. Your Apple Reminders were left unchanged.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added %lld tasks. Skipped %lld already imported and %lld other tasks. Your Apple Reminders were left unchanged."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tâches ajoutées. %lld déjà importées et %lld autres tâches ignorées. Vos rappels Apple n’ont pas été modifiés."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld taken toegevoegd. %lld al geïmporteerde en %lld andere taken overgeslagen. Je Apple Herinneringen zijn niet gewijzigd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Aufgaben hinzugefügt. %lld bereits importierte und %lld andere Aufgaben übersprungen. Deine Apple Erinnerungen wurden nicht geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se añadieron %lld tareas. Se omitieron %lld ya importadas y %lld otras tareas. Tus recordatorios de Apple no se modificaron."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunte %lld attività. Ignorate %lld già importate e %lld altre attività. I tuoi promemoria Apple non sono stati modificati."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionadas %lld tarefas. Ignoradas %lld já importadas e %lld outras tarefas. Os seus Lembretes da Apple não foram alterados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld件のタスクを追加しました。読み込み済みの%lld件とその他の%lld件のタスクはスキップしました。Appleのリマインダーは変更されていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tarefas adicionadas. %lld já importadas e %lld outras tarefas foram ignoradas. Seus Lembretes da Apple não foram alterados."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일 %lld개를 추가했습니다. 이미 가져온 %lld개와 그 밖의 할 일 %lld개는 건너뛰었습니다. Apple 미리 알림은 변경되지 않았습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade till %lld uppgifter. Hoppade över %lld redan importerade och %lld andra uppgifter. Dina Apple Påminnelser lämnades oförändrade."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføjede %lld opgaver. Sprang %lld allerede importerede og %lld andre opgaver over. Dine Apple Påmindelser blev ikke ændret."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La til %lld oppgaver. Hoppet over %lld allerede importerte og %lld andre oppgaver. Apple Påminnelser ble ikke endret."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisättiin %lld tehtävää. Ohitettiin %lld jo tuotua ja %lld muuta tehtävää. Applen Muistutuksia ei muutettu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodano zadań: %lld. Pominięto już zaimportowane (%lld) i inne zadania (%lld). Twoje Przypomnienia Apple pozostały bez zmian."
          }
        }
      }
    },
    "CSV import can either add to what is here or replace it. Tasks are matched by id; categories and projects by name.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV import can either add to what is here or replace it. Tasks are matched by id; categories and projects by name."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’import CSV peut compléter ce qui est ici ou le remplacer. Les tâches sont reconnues par identifiant ; les catégories et les projets par nom."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV-import kan bestaande taken aanvullen of vervangen. Taken worden herkend op id; categorieën en projecten op naam."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der CSV-Import kann vorhandene Aufgaben ergänzen oder ersetzen. Aufgaben werden per ID erkannt, Kategorien und Projekte per Name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La importación CSV puede añadir a lo que hay o reemplazarlo. Las tareas se reconocen por identificador; las categorías y los proyectos por nombre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’importazione CSV può aggiungere alle attività esistenti o sostituirle. Le attività vengono riconosciute per ID; categorie e progetti per nome."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A importação CSV pode acrescentar ao que existe ou substituí-lo. As tarefas são reconhecidas por ID; categorias e projetos por nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CSVの読み込みでは、ここにあるものに追加するか、置き換えるかを選べます。タスクはIDで、カテゴリとプロジェクトは名前で照合されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A importação CSV pode acrescentar ao que existe ou substituí-lo. As tarefas são reconhecidas por ID; categorias e projetos por nome."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV 가져오기는 현재 내용에 추가하거나 대체할 수 있습니다. 할 일은 ID로, 카테고리와 프로젝트는 이름으로 대조합니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV-import kan antingen lägga till det som finns eller ersätta det. Uppgifter matchas på id, kategorier och projekt på namn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV-import kan enten tilføje til det, der er her, eller erstatte det. Opgaver matches efter id, kategorier og projekter efter navn."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV-import kan enten legge til det som er her, eller erstatte det. Oppgaver matches på id, kategorier og prosjekter på navn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV-tuonti voi joko lisätä olemassa olevaan tai korvata sen. Tehtävät yhdistetään tunnuksen, luokat ja projektit nimen perusteella."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Import CSV może dodać dane do istniejących albo je zastąpić. Zadania są dopasowywane według identyfikatora, kategorie i projekty według nazwy."
          }
        }
      }
    },
