    "Tasks you are still waiting on remain in Waiting. New arrivals will be included in your next review.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches toujours en attente y restent. Les nouvelles seront incluses dans votre prochaine révision."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taken waarop je nog wacht blijven in Wachten. Nieuwe taken komen bij de volgende ronde aan bod."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben, auf die du noch wartest, bleiben in Wartend. Neue Aufgaben kommen bei der nächsten Durchsicht hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas pendientes permanecen en En espera. Las nuevas se incluirán en la próxima revisión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività ancora in attesa restano lì. Le nuove saranno incluse nella prossima revisione."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas ainda pendentes permanecem em Em espera. As novas serão incluídas na próxima revisão."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ待っているタスクは「待機中」に残ります。新しく届いたタスクは、次回のレビューに含まれます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas que você ainda aguarda permanecem em Aguardando. As novas entram na sua próxima revisão."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 기다리는 할 일은 ‘대기 중’에 남습니다. 새로 도착한 할 일은 다음 검토에 포함됩니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppgifter du fortfarande väntar på stannar i Väntar. Nya uppgifter tas med i nästa granskning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgaver, du stadig venter på, bliver i Venter. Nye opgaver tages med i din næste gennemgang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppgaver du fortsatt venter på, blir i Venter. Nye oppgaver tas med i neste gjennomgang."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehtävät, joita yhä odotat, pysyvät kohdassa Odottaa. Uudet tehtävät otetaan mukaan seuraavaan läpikäyntiin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadania, na które nadal czekasz, zostają w sekcji Oczekujące. Nowe zadania zostaną uwzględnione w następnym przeglądzie."
          }
        }
      }
    },
