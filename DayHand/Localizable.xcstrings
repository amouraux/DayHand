    "This is one of the automatic backups. They are replaced as the days pass, but until then there is no copy from that day.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist eine der automatischen Sicherungen. Sie werden mit den Tagen ersetzt, doch bis dahin gibt es keine Kopie von diesem Tag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es una de las copias automáticas. Se reemplazan con el paso de los días, pero hasta entonces no habrá copia de ese día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est l’une des sauvegardes automatiques. Elles sont remplacées au fil des jours, mais d’ici là il n’y aura pas de copie de ce jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È una delle copie automatiche. Vengono sostituite con il passare dei giorni, ma fino ad allora non ci sarà una copia di quel giorno."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een van de automatische back-ups. Ze worden in de loop van de dagen vervangen, maar tot die tijd is er geen kopie van die dag."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É uma das cópias automáticas. São substituídas com o passar dos dias, mas até lá não haverá cópia desse dia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは自動バックアップの1つです。日が経つと置き換えられるため、それまでの間はその日のコピーがなくなります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é um dos backups automáticos. Eles são substituídos com o passar dos dias, mas até lá não haverá backup desse dia."
          }
        }
      }
    },
