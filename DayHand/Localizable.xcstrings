    "Capitals are added for you, the way a project typed into a task gets them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Großbuchstaben werden für Sie ergänzt, genau wie bei einem Projekt, das in eine Aufgabe getippt wird."
          }
        },
        "es": {
          "stringUnit": {
