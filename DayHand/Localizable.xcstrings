    "Decide where each Inbox task belongs, one at a time. You can stop and resume whenever you like.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décidez où placer chaque tâche de la boîte de réception, une à une. Vous pouvez arrêter et reprendre à tout moment."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaal één voor één waar elke Inbox-taak thuishoort. Je kunt altijd stoppen en verdergaan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entscheide für jede Aufgabe im Eingang, wohin sie gehört. Du kannst jederzeit aufhören und fortfahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide dónde va cada tarea de la bandeja de entrada, una por una. Puedes parar y continuar cuando quieras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Decidi dove va ogni attività nella posta in arrivo, una alla volta. Puoi interrompere e riprendere quando vuoi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Decida onde fica cada tarefa da caixa de entrada, uma de cada vez. Pode parar e retomar quando quiser."
          }
        }
      }
    },
