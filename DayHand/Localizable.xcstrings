    "Choosing one replaces the last. Touch and hold a row — right-click on the Mac — to add it instead.": {
      "comment": "Footer under Everything, explaining how to select several",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zeile zu wählen ersetzt die vorige. Eine Zeile gedrückt halten — auf dem Mac rechtsklicken —, um sie stattdessen hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir una fila sustituye a la anterior. Mantén pulsada una fila —clic derecho en el Mac— para añadirla en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir une ligne remplace la précédente. Touchez une ligne et maintenez — clic droit sur le Mac — pour l’ajouter à la place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegliere una riga sostituisce la precedente. Tocca e tieni premuta una riga — clic destro sul Mac — per aggiungerla invece."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén kiezen vervangt de vorige. Houd een rij ingedrukt — rechtsklik op de Mac — om die er juist bij te nemen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolher uma linha substitui a anterior. Toque sem soltar numa linha — clique com o botão direito no Mac — para a adicionar."
          }
        }
      }
    },
    "Clear search": {
      "comment": "Accessibility label for the x in the search field",
      "localizations": {
