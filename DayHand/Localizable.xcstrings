    "“%@” does not look like a DayHand file, so it was not used. Syncing would have overwritten what it holds. Nothing was changed." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ligner ikke en DayHand-fil, så den blev ikke brugt. Synkronisering ville have overskrevet dens indhold. Intet blev ændret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ sieht nicht wie eine DayHand-Datei aus und wurde deshalb nicht verwendet. Beim Synchronisieren wäre ihr Inhalt überschrieben worden. Es wurde nichts geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» no parece un archivo de DayHand, así que no se ha usado. Al sincronizar se habría sobrescrito su contenido. No se ha cambiado nada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” ei näytä DayHand-tiedostolta, joten sitä ei käytetty. Synkronointi olisi ylikirjoittanut sen sisällön. Mitään ei muutettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » ne ressemble pas à un fichier DayHand ; il n’a donc pas été utilisé. La synchronisation aurait écrasé son contenu. Rien n’a été modifié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» non sembra un file di DayHand, quindi non è stato usato. La sincronizzazione ne avrebbe sovrascritto il contenuto. Non è stato modificato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はDayHandのファイルではないようなので、使用されませんでした。同期すると、その内容が上書きされてしまいます。何も変更されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”은(는) DayHand 파일이 아닌 것 같아 사용하지 않았습니다. 동기화하면 그 안의 내용을 덮어쓰게 됩니다. 아무것도 변경되지 않았습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» ser ikke ut som en DayHand-fil, så den ble ikke brukt. Synkronisering ville ha overskrevet innholdet. Ingenting ble endret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” lijkt niet op een DayHand-bestand en is daarom niet gebruikt. Synchroniseren had de inhoud overschreven. Er is niets gewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” nie wygląda na plik DayHand, więc nie został użyty. Synchronizacja nadpisałaby jego zawartość. Nic nie zostało zmienione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” não parece um arquivo do DayHand, então não foi usado. A sincronização teria sobrescrito o que ele contém. Nada foi alterado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» não parece um ficheiro do DayHand, por isso não foi utilizado. A sincronização teria substituído o seu conteúdo. Não foi alterado nada."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” ser inte ut som en DayHand-fil, så den användes inte. Synkronisering hade skrivit över dess innehåll. Inget ändrades."
          }
        }
      }
    },
    "“%@” was saved by a newer version of DayHand, so it was not used. Update DayHand to use it. Nothing was changed." : {
      "comment" : "Shown when the chosen sync file was saved by a newer DayHand",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” blev gemt af en nyere version af DayHand, så den blev ikke brugt. Opdatér DayHand for at bruge den. Intet er ændret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wurde mit einer neueren Version von DayHand gespeichert und deshalb nicht verwendet. Aktualisieren Sie DayHand, um sie zu verwenden. Es wurde nichts geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» se guardó con una versión más reciente de DayHand, así que no se ha usado. Actualiza DayHand para usarlo. No se ha cambiado nada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” tallennettiin DayHandin uudemmalla versiolla, joten sitä ei käytetty. Päivitä DayHand käyttääksesi sitä. Mitään ei muutettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » a été enregistré par une version plus récente de DayHand ; il n’a donc pas été utilisé. Mettez DayHand à jour pour l’utiliser. Rien n’a été modifié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» è stato salvato da una versione più recente di DayHand, quindi non è stato usato. Aggiorna DayHand per usarlo. Non è stato cambiato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はより新しいバージョンのDayHandで保存されたため、使用されませんでした。使うにはDayHandをアップデートしてください。何も変更されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”은(는) 더 최신 버전의 DayHand에서 저장되어 사용하지 않았습니다. 사용하려면 DayHand를 업데이트하세요. 아무것도 변경되지 않았습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» ble lagret av en nyere versjon av DayHand, så den ble ikke brukt. Oppdater DayHand for å bruke den. Ingenting er endret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is opgeslagen door een nieuwere versie van DayHand en is daarom niet gebruikt. Werk DayHand bij om het te gebruiken. Er is niets gewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” zapisano w nowszej wersji DayHand, więc nie został użyty. Zaktualizuj DayHand, aby go używać. Nic nie zostało zmienione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” foi salvo por uma versão mais recente do DayHand, então não foi usado. Atualize o DayHand para usá-lo. Nada foi alterado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» foi guardado por uma versão mais recente do DayHand, por isso não foi utilizado. Atualize o DayHand para o utilizar. Não foi alterado nada."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” sparades av en nyare version av DayHand, så den användes inte. Uppdatera DayHand för att använda den. Inget har ändrats."
          }
        }
      }
    },
