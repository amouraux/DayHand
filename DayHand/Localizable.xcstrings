            "value": "Die Erinnerungen konnten nicht gelesen werden. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer los recordatorios. Vuelve a intentarlo."
