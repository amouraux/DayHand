    "%@’s %lld tasks move to %@, and %@ is removed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die %2$lld Aufgaben von %1$@ wandern zu %3$@, und %4$@ wird entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@’s %2$lld tasks move to %3$@, and %4$@ is removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las %2$lld tareas de %1$@ pasan a %3$@, y %4$@ se elimina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %2$lld tâches de %1$@ passent dans %3$@, et %4$@ est supprimé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le %2$lld attività di %1$@ passano a %3$@, e %4$@ viene rimosso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De %2$lld taken van %1$@ gaan naar %3$@, en %4$@ verdwijnt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As %2$lld tarefas de %1$@ passam para %3$@, e %4$@ é removido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の%2$lld件のタスクを%3$@に移動し、%4$@を削除します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As %2$lld tarefas de %1$@ passam para %3$@, e %4$@ é removido."
          }
        }
      }
    },
