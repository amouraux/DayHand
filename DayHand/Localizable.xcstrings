    "No backups yet. One is taken automatically each day the app is opened.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Sicherungen. An jedem Tag, an dem die App geöffnet wird, entsteht automatisch eine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay copias. Se hace una automáticamente cada día que se abre la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune sauvegarde pour l’instant. Une est prise automatiquement chaque jour où l’app est ouverte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun backup. Ne viene creato uno in automatico ogni giorno in cui l’app viene aperta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen back-ups. Er wordt er automatisch één gemaakt op elke dag dat de app wordt geopend."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem cópias. É feita uma automaticamente em cada dia em que a app é aberta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップはまだありません。Appを開いた日ごとに、自動で1つ作成されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum backup ainda. Um é feito automaticamente a cada dia em que o app é aberto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 백업이 없습니다. 앱을 여는 날마다 자동으로 하나가 만들어집니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga säkerhetskopior än. En tas automatiskt varje dag appen öppnas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen backups endnu. Der tages automatisk én hver dag, appen åbnes."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen sikkerhetskopier ennå. Én tas automatisk hver dag appen åpnes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
