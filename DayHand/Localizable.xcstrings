    "Merging keeps both sides. Replacing discards the %lld tasks here and takes the file's.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammenführen behält beide Seiten. Ersetzen verwirft die %lld Aufgaben hier und übernimmt die der Datei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinar conserva ambos lados. Reemplazar descarta las %lld tareas de aquí y toma las del archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fusionner garde les deux côtés. Remplacer écarte les %lld tâches présentes et prend celles du fichier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unire mantiene entrambe le parti. Sostituire scarta le %lld attività qui e prende quelle del file."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samenvoegen behoudt beide kanten. Vervangen gooit de %lld taken hier weg en neemt die van het bestand."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinar mantém os dois lados. Substituir descarta as %lld tarefas daqui e fica com as do ficheiro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "統合すると両方が残ります。置き換えると、ここにある%lld件のタスクが破棄され、ファイルの内容に置き換わります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinar mantém os dois lados. Substituir descarta as %lld tarefas daqui e fica com as do arquivo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병합하면 양쪽이 모두 유지됩니다. 바꾸면 여기에 있는 할 일 %lld개는 버려지고 파일의 내용으로 대체됩니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammanslagning behåller båda sidor. Ersättning kastar de %lld uppgifterna här och tar filens."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fletning beholder begge sider. Erstatning kasserer de %lld opgaver her og overtager filens."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammenslåing beholder begge sider. Erstatning forkaster de %lld oppgavene her og tar filens."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistäminen säilyttää molemmat puolet. Korvaaminen hylkää täällä olevat %lld tehtävää ja ottaa tiedoston tehtävät."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scalenie zachowuje obie strony. Zastąpienie odrzuca zadania tutaj (%lld) i przejmuje te z pliku."
          }
        }
      }
    },
