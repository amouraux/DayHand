    "DayHand" : {
      "shouldTranslate" : false
    },
    "DayHand CSV import can either add to what is here or replace the tasks. Rows are matched by id, then by name, and only what the file says is changed." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DayHands CSV-import kan enten tilføje til det, der er her, eller erstatte opgaverne. Rækker matches efter id, derefter efter navn, og kun det, filen angiver, ændres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der DayHand-CSV-Import kann ergänzen oder die Aufgaben ersetzen. Zeilen werden per ID, dann per Name erkannt, und nur das, was die Datei sagt, wird geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La importación CSV de DayHand puede añadir a lo que hay o reemplazar las tareas. Las filas se reconocen por identificador y luego por nombre, y solo se cambia lo que dice el archivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DayHandin CSV-tuonti voi joko lisätä olemassa olevaan tai korvata tehtävät. Rivit yhdistetään ensin tunnuksen, sitten nimen perusteella, ja vain tiedoston kertoma muuttuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’import CSV DayHand peut compléter ce qui est ici ou remplacer les tâches. Les lignes sont reconnues par identifiant, puis par nom, et seul ce que dit le fichier est modifié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’importazione CSV di DayHand può aggiungere a ciò che c’è o sostituire le attività. Le righe vengono riconosciute per identificativo, poi per nome, e viene modificato solo ciò che dice il file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DayHandのCSVの読み込みでは、ここにあるものに追加するか、タスクを置き換えるかを選べます。行はIDで、次に名前で照合され、ファイルに書かれている内容だけが変更されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DayHand CSV 가져오기는 현재 내용에 추가하거나 할 일을 대체할 수 있습니다. 행은 ID로, 그다음 이름으로 대조하며, 파일에 적힌 내용만 변경됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DayHands CSV-import kan enten legge til det som er her, eller erstatte oppgavene. Rader matches på id, deretter på navn, og bare det filen oppgir, endres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DayHand-CSV-import kan aanvullen of de taken vervangen. Rijen worden herkend op id, dan op naam, en alleen wat het bestand zegt wordt gewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import CSV z DayHand może dodać dane do istniejących albo zastąpić zadania. Wiersze są dopasowywane najpierw według identyfikatora, potem według nazwy, a zmienia się tylko to, co mówi plik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A importação de CSV do DayHand pode acrescentar ao que existe ou substituir as tarefas. As linhas são reconhecidas pelo ID e depois pelo nome, e só é alterado o que o arquivo diz."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A importação CSV do DayHand pode acrescentar ao que existe ou substituir as tarefas. As linhas são reconhecidas pelo ID e depois pelo nome, e só é alterado o que o ficheiro diz."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DayHands CSV-import kan antingen lägga till det som finns eller ersätta uppgifterna. Rader matchas på id, sedan på namn, och bara det filen anger ändras."
          }
        }
      }
    },
