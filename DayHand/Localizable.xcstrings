            "state": "translated",
            "value": "Suis-je encore en attente, ou puis-je avancer ?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht ik nog, of kan dit verder?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte ich noch, oder kann es weitergehen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Sigo esperando o puede avanzar?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sto ancora aspettando o posso andare avanti?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda estou à espera ou isto pode avançar?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ待っていますか？それとも先に進められますか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda estou aguardando, ou isso pode avançar?"
          }
        }
      }
    },
