    "Moving a task keeps its reminder and deadline." : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du flytter en opgave, beholdes dens påmindelse og deadline."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Verschieben bleiben Erinnerung und Frist erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al mover una tarea se conservan su recordatorio y fecha límite."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tehtävän siirtäminen säilyttää sen muistutuksen ja määräajan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacer une tâche conserve son rappel et son échéance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spostare un’attività mantiene il promemoria e la scadenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タスクを移動しても、リマインダーと期限は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "할 일을 옮겨도 미리 알림과 마감일은 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du flytter en oppgave, beholdes påminnelsen og fristen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij verplaatsen blijven de herinnering en deadline behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeniesienie zadania zachowuje jego przypomnienie i termin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mover uma tarefa mantém o lembrete e o prazo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mover uma tarefa mantém o lembrete e o prazo."
          }
