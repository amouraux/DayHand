    "Projects with nothing left to do come last, so you can archive them. Tasks without a project stay in the task reviews." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekter, hvor der ikke er noget tilbage at gøre, kommer sidst, så du kan arkivere dem. Opgaver uden projekt bliver i opgavegennemgangene."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekte ohne offene Aufgaben kommen zuletzt, damit du sie archivieren kannst. Aufgaben ohne Projekt bleiben in der Aufgabendurchsicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los proyectos sin nada pendiente van al final, para que puedas archivarlos. Las tareas sin proyecto siguen en las revisiones de tareas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projektit, joissa ei ole mitään tehtävää jäljellä, tulevat viimeisinä, jotta voit arkistoida ne. Tehtävät ilman projektia pysyvät tehtävien läpikäynneissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les projets sans rien à faire viennent en dernier, pour que vous puissiez les archiver. Les tâches sans projet restent dans les révisions de tâches."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I progetti senza nulla da fare vengono per ultimi, così puoi archiviarli. Le attività senza progetto restano nelle revisioni delle attività."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "やることが残っていないプロジェクトは最後に並ぶので、アーカイブできます。プロジェクトのないタスクは、タスクのレビューに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "할 일이 남지 않은 프로젝트는 맨 뒤에 나오므로 보관할 수 있습니다. 프로젝트가 없는 할 일은 할 일 검토에 남습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosjekter uten noe igjen å gjøre kommer sist, slik at du kan arkivere dem. Oppgaver uten prosjekt blir i oppgavegjennomgangene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projecten zonder openstaand werk komen als laatste, zodat je ze kunt archiveren. Taken zonder project blijven in de takenrondes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekty bez niczego do zrobienia są na końcu, żebyś mógł je zarchiwizować. Zadania bez projektu zostają w przeglądach zadań."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projetos sem nada para fazer ficam por último, para você poder arquivá-los. As tarefas sem projeto ficam nas revisões de tarefas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os projetos sem nada por fazer vêm no fim, para os poder arquivar. As tarefas sem projeto ficam nas revisões de tarefas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekt utan något kvar att göra kommer sist, så att du kan arkivera dem. Uppgifter utan projekt finns kvar i uppgiftsgranskningarna."
          }
        }
      }
    },
