    "Renames “%@” on every project in it; using another group’s name joins the two. Ungroup takes the label off them and keeps the projects.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benennt „%@“ in all seinen Projekten um; der Name einer anderen Gruppe führt beide zusammen. „Gruppierung aufheben“ nimmt ihnen das Etikett und behält die Projekte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renombra «%@» en todos sus proyectos; usar el nombre de otro grupo une los dos. Desagrupar les quita la etiqueta y conserva los proyectos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renomme « %@ » sur tous ses projets ; reprendre le nom d’un autre groupe fusionne les deux. Dissoudre le groupe leur retire l’étiquette et conserve les projets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinomina «%@» su tutti i suoi progetti; usare il nome di un altro gruppo li unisce. Separa toglie loro l’etichetta e mantiene i progetti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hernoemt “%@” op al zijn projecten; de naam van een andere groep gebruiken voegt beide samen. Groep opheffen haalt het label eraf en behoudt de projecten."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda o nome de «%@» em todos os seus projetos; usar o nome de outro grupo junta os dois. Desagrupar retira-lhes a etiqueta e mantém os projetos."
          }
        }
      }
    },
    "Renaming changes it on every task at once.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Umbenennen ändert es auf einen Schlag bei jeder Aufgabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al renombrar, cambia en todas las tareas a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le renommage s’applique à toutes les tâches d’un coup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinominare lo cambia su tutte le attività in una volta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hernoemen wijzigt het in één keer bij elke taak."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudar o nome altera-o em todas as tarefas de uma vez."
          }
        }
      }
    },
