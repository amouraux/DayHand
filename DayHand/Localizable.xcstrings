    "Capitals are added for you, the way a project typed into a task gets them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Großbuchstaben werden für Sie ergänzt, genau wie bei einem Projekt, das in eine Aufgabe getippt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las mayúsculas se añaden solas, igual que en un proyecto escrito dentro de una tarea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les majuscules sont ajoutées pour vous, comme pour un projet tapé dans une tâche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le maiuscole vengono aggiunte da sole, come per un progetto digitato in un’attività."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoofdletters worden voor je toegevoegd, net als bij een project dat je in een taak typt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As maiúsculas são adicionadas por si, tal como num projeto escrito dentro de uma tarefa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクにプロジェクトを入力したときと同じように、大文字は自動で付きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As maiúsculas são adicionadas para você, como acontece com um projeto digitado dentro de uma tarefa."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일에 프로젝트를 입력할 때처럼 대문자는 자동으로 적용됩니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Versaler läggs till åt dig, precis som när ett projekt skrivs i en uppgift."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Store bogstaver tilføjes for dig, ligesom når et projekt skrives ind i en opgave."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Store bokstaver legges til for deg, slik som når et prosjekt skrives inn i en oppgave."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Isot kirjaimet lisätään puolestasi, samalla tavalla kuin kun projekti kirjoitetaan tehtävään."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wielkie litery są dodawane za Ciebie, tak jak przy projekcie wpisanym w zadaniu."
          }
        }
      }
    },
