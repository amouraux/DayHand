    "The %lld tasks here will be replaced by the %lld in this file. Categories and projects come back too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die %1$lld Aufgaben hier werden durch die %2$lld dieser Datei ersetzt. Kategorien und Projekte kommen ebenfalls zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %1$lld tasks here will be replaced by the %2$lld in this file. Categories and projects come back too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las %1$lld tareas de aquí se reemplazarán por las %2$lld de este archivo. Las categorías y los proyectos también vuelven."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %1$lld tâches présentes seront remplacées par les %2$lld de ce fichier. Les catégories et les projets reviennent aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le %1$lld attività qui saranno sostituite dalle %2$lld di questo file. Tornano anche categorie e progetti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De %1$lld taken hier worden vervangen door de %2$lld in dit bestand. Categorieën en projecten komen ook terug."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As %1$lld tarefas daqui serão substituídas pelas %2$lld deste ficheiro. As categorias e os projetos também voltam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにある%1$lld件のタスクは、このファイルの%2$lld件に置き換わります。カテゴリとプロジェクトも元に戻ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As %1$lld tarefas daqui serão substituídas pelas %2$lld deste arquivo. As categorias e os projetos também voltam."
          }
        }
      }
    },
