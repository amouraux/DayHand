        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisão concluída. Volte à vista geral do projeto para decidir se o próximo passo está claro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクのレビューが完了しました。プロジェクトの概要に戻り、進め方がはっきりしているか確認しましょう。"
          }
