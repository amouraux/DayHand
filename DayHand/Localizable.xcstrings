          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer le rappel"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi il promemoria"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinnering verwijderen"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover o lembrete"
          }
        }
      }
    },
    "Clicking a row picks that one; use the checkbox beside it to pick several. Click ⓘ to rename a project, a group or a category, to move a project, or to put one away.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Klick auf eine Zeile wählt diese aus; mit dem Kästchen daneben wählen Sie mehrere. Klicken Sie auf ⓘ, um ein Projekt, eine Gruppe oder eine Kategorie umzubenennen, ein Projekt zu verschieben oder eines abzulegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer clic en una fila selecciona esa; usa la casilla contigua para seleccionar varias. Haz clic en ⓘ para renombrar un proyecto, un grupo o una categoría, mover un proyecto o archivarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquer sur une ligne sélectionne celle-ci ; utilisez la case à côté pour en sélectionner plusieurs. Cliquez sur ⓘ pour renommer un projet, un groupe ou une catégorie, déplacer un projet ou en ranger un."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fare clic su una riga seleziona quella; usa la casella accanto per selezionarne diverse. Fai clic su ⓘ per rinominare un progetto, un gruppo o una categoria, spostare un progetto o archiviarne uno."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op een rij klikken kiest die ene; gebruik het vakje ernaast om er meerdere te kiezen. Klik op ⓘ om een project, groep of categorie te hernoemen, een project te verplaatsen of er een op te bergen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicar numa linha seleciona essa; use a caixa ao lado para selecionar várias. Clique em ⓘ para mudar o nome de um projeto, grupo ou categoria, mover um projeto ou arquivar um."
          }
        }
      }
    },
