    "Free": {
      "shouldTranslate": false
    },
    "Paid": {
      "shouldTranslate": false
    },
    "DayHand": {
      "shouldTranslate": false
    },
    "Only in test builds. Free applies the project and history limits on this device; Paid removes them.": {
      "shouldTranslate": false
    },
    "You have %lld active projects; the free version keeps up to %lld. To add one, archive or merge projects until you have fewer than %lld, or unlock DayHand.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %lld aktive Projekte; die kostenlose Version erlaubt bis zu %lld. Um eines hinzuzufügen, archiviere oder führe Projekte zusammen, bis du weniger als %lld hast, oder schalte DayHand frei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes %lld proyectos activos; la versión gratuita admite hasta %lld. Para añadir uno, archiva o fusiona proyectos hasta tener menos de %lld, o desbloquea DayHand."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez %lld projets actifs ; la version gratuite en permet jusqu’à %lld. Pour en ajouter un, archivez ou fusionnez des projets jusqu’à en avoir moins de %lld, ou débloquez DayHand."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai %lld progetti attivi; la versione gratuita ne consente fino a %lld. Per aggiungerne uno, archivia o unisci progetti finché ne hai meno di %lld, oppure sblocca DayHand."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt %lld actieve projecten; de gratis versie biedt plaats aan maximaal %lld. Archiveer of voeg projecten samen tot je er minder dan %lld hebt om er een toe te voegen, of ontgrendel DayHand."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem %lld projetos ativos; a versão gratuita permite até %lld. Para adicionar um, arquive ou una projetos até ter menos de %lld, ou desbloqueie o DayHand."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進行中のプロジェクトが%lld件あります。無料版は%lld件までです。追加するには、%lld件未満になるまでプロジェクトをアーカイブまたは統合するか、DayHandをアンロックしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem %lld projetos ativos; a versão gratuita permite até %lld. Para adicionar um, arquive ou mescle projetos até ter menos de %lld, ou desbloqueie o DayHand."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 중인 프로젝트가 %lld개 있으며, 무료 버전에서는 %lld개까지 둘 수 있습니다. 하나를 추가하려면 %lld개 미만이 될 때까지 프로젝트를 보관하거나 병합하거나, DayHand를 잠금 해제하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har %lld aktiva projekt; den kostnadsfria versionen rymmer upp till %lld. Om du vill lägga till ett arkiverar eller slår du ihop projekt tills du har färre än %lld, eller låser upp DayHand."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har %lld aktive projekter; den gratis version rummer op til %lld. For at tilføje et skal du arkivere eller flette projekter, til du har færre end %lld, eller låse DayHand op."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har %lld aktive prosjekter; den gratis versjonen har plass til opptil %lld. For å legge til ett må du arkivere eller slå sammen prosjekter til du har færre enn %lld, eller låse opp DayHand."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinulla on %lld aktiivista projektia; ilmaisversiossa voi olla enintään %lld. Voit lisätä yhden arkistoimalla tai yhdistämällä projekteja, kunnes niitä on alle %lld, tai avaamalla DayHandin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz aktywnych projektów: %lld; wersja darmowa pozwala na maksymalnie %lld. Aby dodać kolejny, zarchiwizuj lub scal projekty, aż będzie ich mniej niż %lld, albo odblokuj DayHand."
          }
        }
      }
    },
    "You have %lld active projects; the free version keeps up to %lld. Your task was added without the project %@. To add one, archive or merge projects until you have fewer than %lld, or unlock DayHand.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %lld aktive Projekte; die kostenlose Version erlaubt bis zu %lld. Deine Aufgabe wurde ohne das Projekt %@ hinzugefügt. Um eines hinzuzufügen, archiviere oder führe Projekte zusammen, bis du weniger als %lld hast, oder schalte DayHand frei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes %lld proyectos activos; la versión gratuita admite hasta %lld. Tu tarea se añadió sin el proyecto %@. Para añadir uno, archiva o fusiona proyectos hasta tener menos de %lld, o desbloquea DayHand."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez %lld projets actifs ; la version gratuite en permet jusqu’à %lld. Votre tâche a été ajoutée sans le projet %@. Pour en ajouter un, archivez ou fusionnez des projets jusqu’à en avoir moins de %lld, ou débloquez DayHand."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai %lld progetti attivi; la versione gratuita ne consente fino a %lld. La tua attività è stata aggiunta senza il progetto %@. Per aggiungerne uno, archivia o unisci progetti finché ne hai meno di %lld, oppure sblocca DayHand."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt %lld actieve projecten; de gratis versie biedt plaats aan maximaal %lld. Je taak is toegevoegd zonder het project %@. Archiveer of voeg projecten samen tot je er minder dan %lld hebt om er een toe te voegen, of ontgrendel DayHand."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem %lld projetos ativos; a versão gratuita permite até %lld. A sua tarefa foi adicionada sem o projeto %@. Para adicionar um, arquive ou una projetos até ter menos de %lld, ou desbloqueie o DayHand."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進行中のプロジェクトが%lld件あります。無料版は%lld件までです。プロジェクト「%@」なしでタスクを追加しました。追加するには、%lld件未満になるまでプロジェクトをアーカイブまたは統合するか、DayHandをアンロックしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem %lld projetos ativos; a versão gratuita permite até %lld. Sua tarefa foi adicionada sem o projeto %@. Para adicionar um, arquive ou mescle projetos até ter menos de %lld, ou desbloqueie o DayHand."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 중인 프로젝트가 %lld개 있으며, 무료 버전에서는 %lld개까지 둘 수 있습니다. 할 일은 프로젝트 %@ 없이 추가되었습니다. 하나를 추가하려면 %lld개 미만이 될 때까지 프로젝트를 보관하거나 병합하거나, DayHand를 잠금 해제하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har %lld aktiva projekt; den kostnadsfria versionen rymmer upp till %lld. Din uppgift lades till utan projektet %@. Om du vill lägga till ett arkiverar eller slår du ihop projekt tills du har färre än %lld, eller låser upp DayHand."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har %lld aktive projekter; den gratis version rummer op til %lld. Din opgave blev tilføjet uden projektet %@. For at tilføje et skal du arkivere eller flette projekter, til du har færre end %lld, eller låse DayHand op."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har %lld aktive prosjekter; den gratis versjonen har plass til opptil %lld. Oppgaven din ble lagt til uten prosjektet %@. For å legge til ett må du arkivere eller slå sammen prosjekter til du har færre enn %lld, eller låse opp DayHand."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinulla on %lld aktiivista projektia; ilmaisversiossa voi olla enintään %lld. Tehtäväsi lisättiin ilman projektia %@. Voit lisätä yhden arkistoimalla tai yhdistämällä projekteja, kunnes niitä on alle %lld, tai avaamalla DayHandin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz aktywnych projektów: %lld; wersja darmowa pozwala na maksymalnie %lld. Twoje zadanie dodano bez projektu %@. Aby dodać kolejny, zarchiwizuj lub scal projekty, aż będzie ich mniej niż %lld, albo odblokuj DayHand."
          }
        }
      }
    },
