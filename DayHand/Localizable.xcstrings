        }
      }
    },
    "The free version keeps up to %lld active projects. Your task was added without the project %@. Archive a project you have finished to make room, or unlock DayHand.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kostenlose Version erlaubt bis zu %lld aktive Projekte. Deine Aufgabe wurde ohne das Projekt %@ hinzugefügt. Archiviere ein beendetes Projekt, um Platz zu schaffen, oder schalte DayHand frei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión gratuita admite hasta %lld proyectos activos. Tu tarea se añadió sin el proyecto %@. Archiva un proyecto terminado para hacer sitio, o desbloquea DayHand."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version gratuite permet jusqu’à %lld projets actifs. Votre tâche a été ajoutée sans le projet %@. Archivez un projet terminé pour faire de la place, ou débloquez DayHand."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione gratuita consente fino a %lld progetti attivi. La tua attività è stata aggiunta senza il progetto %@. Archivia un progetto concluso per fare spazio, oppure sblocca DayHand."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gratis versie biedt plaats aan maximaal %lld actieve projecten. Je taak is toegevoegd zonder het project %@. Archiveer een afgerond project om ruimte te maken, of ontgrendel DayHand."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão gratuita permite até %lld projetos ativos. A sua tarefa foi adicionada sem o projeto %@. Arquive um projeto terminado para libertar espaço, ou desbloqueie o DayHand."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料版では、進行中のプロジェクトは%lld件までです。プロジェクト「%@」なしでタスクを追加しました。終えたプロジェクトをアーカイブして空きを作るか、DayHandをアンロックしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão gratuita permite até %lld projetos ativos. Sua tarefa foi adicionada sem o projeto %@. Arquive um projeto concluído para abrir espaço, ou desbloqueie o DayHand."
          }
        }
      }
    },
