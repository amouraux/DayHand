    "Your choices are saved. Kept tasks and new arrivals can be reviewed in a new pass.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos choix sont enregistrés. Les tâches conservées et les nouvelles pourront être revues lors d’un prochain passage."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je keuzes zijn opgeslagen. Behouden en nieuwe taken komen in een nieuwe ronde aan bod."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Entscheidungen sind gespeichert. Behaltene und neue Aufgaben können erneut durchgesehen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus decisiones están guardadas. Las tareas conservadas y las nuevas pueden revisarse en otra ronda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue scelte sono salvate. Le attività mantenute e quelle nuove potranno essere riviste in un nuovo passaggio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas escolhas foram guardadas. As tarefas mantidas e as novas podem ser revistas numa nova passagem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択内容を保存しました。残したタスクと新しく届いたタスクは、新しいレビューで見直せます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas escolhas foram salvas. As tarefas mantidas e as novas podem ser revisadas em uma nova passagem."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항을 저장했습니다. 유지한 할 일과 새로 도착한 할 일은 새 검토에서 다시 볼 수 있습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina val har sparats. Uppgifter du behöll och nya som kommit kan granskas i en ny omgång."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine valg er gemt. Opgaver, du beholdt, og nye, der er kommet, kan gennemgås i en ny runde."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgene dine er lagret. Oppgaver du beholdt, og nye som har kommet, kan gås gjennom i en ny runde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valintasi on tallennettu. Säilyttämäsi ja uudet tehtävät voi käydä läpi uudella kierroksella."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje wybory zostały zapisane. Zadania, które zostawiono, i nowe zadania można przejrzeć w kolejnym przebiegu."
          }
        }
      }
    },
