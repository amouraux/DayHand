    "Put one file in iCloud Drive and point every device at it. iCloud syncs the file, so no paid developer account is needed." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læg én fil i iCloud Drive, og peg alle enheder på den. iCloud synkroniserer filen, så du behøver ikke en betalt udviklerkonto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legen Sie eine Datei in iCloud Drive und richten Sie jedes Gerät darauf aus. iCloud synchronisiert die Datei, ein bezahlter Entwickleraccount ist nicht nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon un archivo en iCloud Drive y apunta ahí cada dispositivo. iCloud sincroniza el archivo, así que no hace falta una cuenta de desarrollador de pago."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laita yksi tiedosto iCloud Driveen ja osoita jokainen laite siihen. iCloud synkronoi tiedoston, joten maksullista kehittäjätiliä ei tarvita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placez un fichier dans iCloud Drive et pointez chaque appareil dessus. iCloud synchronise le fichier : aucun compte développeur payant n’est nécessaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti un file in iCloud Drive e fai puntare lì ogni dispositivo. iCloud sincronizza il file, quindi non serve un account sviluppatore a pagamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Driveにファイルを1つ置き、すべてのデバイスでそれを指定します。ファイルはiCloudが同期するので、有料のデベロッパアカウントは必要ありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive에 파일 하나를 두고 모든 기기가 그 파일을 가리키게 하세요. 파일은 iCloud가 동기화하므로 유료 개발자 계정이 필요 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg én fil i iCloud Drive og pek alle enheter mot den. iCloud synkroniserer filen, så du trenger ingen betalt utviklerkonto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet één bestand in iCloud Drive en laat elk apparaat ernaar wijzen. iCloud synchroniseert het bestand, dus een betaald ontwikkelaarsaccount is niet nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umieść jeden plik w iCloud Drive i wskaż go na każdym urządzeniu. iCloud synchronizuje plik, więc nie jest potrzebne płatne konto dewelopera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque um arquivo no iCloud Drive e aponte cada dispositivo para ele. O iCloud sincroniza o arquivo, então não é preciso uma conta de desenvolvedor paga."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque um ficheiro no iCloud Drive e aponte cada dispositivo para ele. O iCloud sincroniza o ficheiro, pelo que não é preciso uma conta de programador paga."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg en fil i iCloud Drive och peka alla enheter på den. iCloud synkroniserar filen, så du behöver inget betalt utvecklarkonto."
          }
        }
      }
    },
