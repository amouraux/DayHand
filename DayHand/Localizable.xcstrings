          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo CSV deve usar a codificação de texto UTF-8."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV 파일은 UTF-8 텍스트 인코딩이어야 합니다."
