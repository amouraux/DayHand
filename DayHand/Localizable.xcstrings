        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일을 탭해서 다른 스택으로 옮기세요"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en uppgift för att flytta den till en annan hög"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
