    "New tasks start with this category. You can still change it on the task.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Aufgaben starten mit dieser Kategorie. An der Aufgabe lässt sie sich weiterhin ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas nuevas empiezan con esta categoría. Puedes cambiarla en la tarea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouvelles tâches démarrent avec cette catégorie. Vous pouvez toujours la changer sur la tâche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nuove attività partono con questa categoria. Puoi sempre cambiarla sull’attività."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe taken starten met deze categorie. Je kunt die op de taak nog wijzigen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas novas começam com esta categoria. Pode alterá-la na tarefa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいタスクはこのカテゴリで始まります。タスクごとに変更もできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas novas começam com esta categoria. Você ainda pode mudá-la na tarefa."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
