    "Removes every task on this device. Categories are kept. If a sync file is in use, the deletion reaches your other devices too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt jede Aufgabe auf diesem Gerät. Kategorien bleiben erhalten. Wird eine Sync-Datei verwendet, erreicht die Löschung auch Ihre anderen Geräte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina todas las tareas de este dispositivo. Las categorías se conservan. Si se usa un archivo de sincronización, la eliminación llega también a tus otros dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime toutes les tâches de cet appareil. Les catégories sont conservées. Si un fichier de synchronisation est utilisé, la suppression touche aussi vos autres appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove ogni attività su questo dispositivo. Le categorie restano. Se è in uso un file di sincronizzazione, l’eliminazione raggiunge anche gli altri dispositivi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert elke taak op dit apparaat. Categorieën blijven behouden. Bij een synchronisatiebestand bereikt de verwijdering ook je andere apparaten."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove todas as tarefas neste dispositivo. As categorias são mantidas. Se estiver em uso um ficheiro de sincronização, a eliminação chega também aos seus outros dispositivos."
          }
        }
      }
    },
