    "Clear the reminder": {
      "comment": "Answer in the reminder review; the deadline is untouched",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerung entfernen"
          }
        },
        "es": {
          "stringUnit": {
