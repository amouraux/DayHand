    "Removes every task on this device. Categories are kept. If a sync file is in use, the deletion reaches your other devices too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt jede Aufgabe auf diesem Gerät. Kategorien bleiben erhalten. Wird eine Sync-Datei verwendet, erreicht die Löschung auch Ihre anderen Geräte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina todas las tareas de este dispositivo. Las categorías se conservan. Si se usa un archivo de sincronización, la eliminación llega también a tus otros dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime toutes les tâches de cet appareil. Les catégories sont conservées. Si un fichier de synchronisation est utilisé, la suppression touche aussi vos autres appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove ogni attività su questo dispositivo. Le categorie restano. Se è in uso un file di sincronizzazione, l’eliminazione raggiunge anche gli altri dispositivi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert elke taak op dit apparaat. Categorieën blijven behouden. Bij een synchronisatiebestand bereikt de verwijdering ook je andere apparaten."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove todas as tarefas neste dispositivo. As categorias são mantidas. Se estiver em uso um ficheiro de sincronização, a eliminação chega também aos seus outros dispositivos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスのすべてのタスクを削除します。カテゴリは残ります。同期ファイルを使っている場合は、削除が他のデバイスにも反映されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove todas as tarefas deste dispositivo. As categorias são mantidas. Se um arquivo de sincronização estiver em uso, a exclusão também chega aos seus outros dispositivos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 모든 할 일을 삭제합니다. 카테고리는 유지됩니다. 동기화 파일을 사용 중이면 삭제가 다른 기기에도 전달됩니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar bort alla uppgifter på den här enheten. Kategorierna behålls. Om en synkroniseringsfil används når borttagningen även dina andra enheter."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner alle opgaver på denne enhed. Kategorierne beholdes. Hvis en synkroniseringsfil er i brug, når sletningen også dine andre enheder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner alle oppgaver på denne enheten. Kategoriene beholdes. Hvis en synkroniseringsfil er i bruk, når slettingen også de andre enhetene dine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa kaikki tämän laitteen tehtävät. Luokat säilyvät. Jos synkronointitiedosto on käytössä, poisto ulottuu myös muille laitteillesi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa wszystkie zadania na tym urządzeniu. Kategorie zostają. Jeśli używany jest plik synchronizacji, usunięcie dotrze także na Twoje pozostałe urządzenia."
          }
        }
      }
    },
