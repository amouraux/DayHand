    "The free version shows the last %lld days of finished tasks. Earlier ones are safe, and appear here once you unlock.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kostenlose Version zeigt erledigte Aufgaben der letzten %lld Tage. Ältere sind sicher aufbewahrt und erscheinen hier, sobald du freischaltest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión gratuita muestra las tareas terminadas de los últimos %lld días. Las anteriores están a salvo y aparecerán aquí cuando desbloquees."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version gratuite affiche les tâches terminées des %lld derniers jours. Les plus anciennes sont en sécurité et apparaîtront ici une fois DayHand débloqué."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione gratuita mostra le attività completate degli ultimi %lld giorni. Quelle precedenti sono al sicuro e compariranno qui dopo lo sblocco."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gratis versie toont afgeronde taken van de laatste %lld dagen. Oudere staan veilig en verschijnen hier zodra je ontgrendelt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão gratuita mostra as tarefas concluídas dos últimos %lld dias. As anteriores estão guardadas e aparecem aqui depois de desbloquear."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料版では、完了したタスクを直近%lld日分表示します。それより前のものは安全に保管されていて、アンロックするとここに表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão gratuita mostra as tarefas concluídas nos últimos %lld dias. As anteriores estão seguras e aparecem aqui depois que você desbloquear."
          }
        }
      }
    },
