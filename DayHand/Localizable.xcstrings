    "Automatic follows your device's language. A change applies the next time DayHand opens.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“Automatisk” følger enhedens sprog. En ændring gælder, næste gang du åbner DayHand."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Automatisch“ folgt der Sprache Ihres Geräts. Eine Änderung gilt, sobald DayHand das nächste Mal geöffnet wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Automático» sigue el idioma de tu dispositivo. El cambio se aplica la próxima vez que abras DayHand."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”Automaattinen” noudattaa laitteen kieltä. Muutos tulee voimaan, kun avaat DayHandin seuraavan kerran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Automatique » suit la langue de votre appareil. Un changement s’applique à la prochaine ouverture de DayHand."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Automatico» segue la lingua del dispositivo. La modifica si applica alla prossima apertura di DayHand."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」はデバイスの言語に従います。変更は、次にDayHandを開いたときに反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘자동’은 기기의 언어를 따릅니다. 변경 사항은 다음에 DayHand를 열 때 적용됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«Automatisk» følger språket på enheten. En endring gjelder neste gang du åpner DayHand."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Automatisch’ volgt de taal van je apparaat. Een wijziging gaat in de volgende keer dat je DayHand opent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Automatyczny” podąża za językiem urządzenia. Zmiana zacznie obowiązywać przy następnym otwarciu DayHand."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Automático” segue o idioma do seu dispositivo. A mudança vale na próxima vez que você abrir o DayHand."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«Automático» segue o idioma do seu dispositivo. A alteração aplica-se da próxima vez que abrir o DayHand."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”Automatiskt” följer enhetens språk. En ändring gäller nästa gång du öppnar DayHand."
          }
        }
      }
    },
