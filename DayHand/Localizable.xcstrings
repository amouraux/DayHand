          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 버전에서는 진행 중인 프로젝트를 %lld개까지 둘 수 있습니다. 끝난 프로젝트를 보관해 자리를 만들거나 DayHand를 잠금 해제하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kostnadsfria versionen rymmer upp till %lld aktiva projekt. Arkivera ett projekt du är klar med för att göra plats, eller lås upp DayHand."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gratis version rummer op til %lld aktive projekter. Arkivér et projekt, du er færdig med, for at gøre plads, eller lås DayHand op."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gratis versjonen har plass til opptil %lld aktive prosjekter. Arkiver et prosjekt du er ferdig med for å gjøre plass, eller lås opp DayHand."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmaisversiossa voi olla enintään %lld aktiivista projektia. Arkistoi valmis projekti tehdäksesi tilaa tai avaa DayHand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersja darmowa pozwala na maksymalnie %lld aktywnych projektów. Zarchiwizuj zakończony projekt, aby zrobić miejsce, albo odblokuj DayHand."
          }
        }
      }
    },
    "The free version shows the last %lld days of finished tasks. Earlier ones are safe, and appear here once you unlock.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kostenlose Version zeigt erledigte Aufgaben der letzten %lld Tage. Ältere sind sicher aufbewahrt und erscheinen hier, sobald du freischaltest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión gratuita muestra las tareas terminadas de los últimos %lld días. Las anteriores están a salvo y aparecerán aquí cuando desbloquees."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version gratuite affiche les tâches terminées des %lld derniers jours. Les plus anciennes sont en sécurité et apparaîtront ici une fois DayHand débloqué."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione gratuita mostra le attività completate degli ultimi %lld giorni. Quelle precedenti sono al sicuro e compariranno qui dopo lo sblocco."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gratis versie toont afgeronde taken van de laatste %lld dagen. Oudere staan veilig en verschijnen hier zodra je ontgrendelt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão gratuita mostra as tarefas concluídas dos últimos %lld dias. As anteriores estão guardadas e aparecem aqui depois de desbloquear."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料版では、完了したタスクを直近%lld日分表示します。それより前のものは安全に保管されていて、アンロックするとここに表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão gratuita mostra as tarefas concluídas nos últimos %lld dias. As anteriores estão seguras e aparecem aqui depois que você desbloquear."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 버전에서는 최근 %lld일 동안 완료한 할 일을 보여 줍니다. 그 이전 항목은 안전하게 보관되어 있으며 잠금을 해제하면 여기에 나타납니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kostnadsfria versionen visar de senaste %lld dagarnas klara uppgifter. Äldre är i säkerhet och visas här när du låser upp."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gratis version viser de seneste %lld dages færdige opgaver. Ældre er i sikkerhed og vises her, når du låser op."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gratis versjonen viser fullførte oppgaver de siste %lld dagene. Eldre er trygge og vises her når du låser opp."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmaisversio näyttää valmiit tehtävät viimeisen %lld päivän ajalta. Vanhemmat ovat turvassa ja näkyvät täällä, kun avaat sovelluksen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersja darmowa pokazuje ukończone zadania z ostatnich dni: %lld. Wcześniejsze są bezpieczne i pojawią się tutaj po odblokowaniu."
          }
        }
      }
    },
