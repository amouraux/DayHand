        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Granskningen av uppgifterna är klar. Gå tillbaka till projektöversikten och avgör om det finns en tydlig väg framåt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gennemgangen af opgaver er færdig. Gå tilbage til projektoversigten for at afgøre, om der er en klar vej frem."
