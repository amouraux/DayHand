    "Groups gather projects that belong together, such as Grants or Courses.": {
      "comment": "Explains what a group is, under the New Group field",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruppen fassen Projekte zusammen, die zusammengehören, etwa Förderungen oder Kurse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los grupos reúnen proyectos que van juntos, como Becas o Cursos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les groupes rassemblent des projets qui vont ensemble, comme Subventions ou Cours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I gruppi riuniscono progetti che stanno insieme, come Finanziamenti o Corsi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Groepen bundelen projecten die bij elkaar horen, zoals Subsidies of Cursussen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os grupos reúnem projetos que andam juntos, como Bolsas ou Cursos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループは、「助成金」や「講義」のように、関連するプロジェクトをまとめます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os grupos reúnem projetos que andam juntos, como Bolsas ou Cursos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹은 연구비나 강의처럼 서로 관련된 프로젝트를 모아 줍니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupper samlar projekt som hör ihop, till exempel Anslag eller Kurser."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupper samler projekter, der hører sammen, for eksempel Legater eller Kurser."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupper samler prosjekter som hører sammen, for eksempel Stipender eller Kurs."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ryhmät kokoavat yhteen kuuluvia projekteja, kuten Apurahat tai Kurssit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupy zbierają projekty, które do siebie pasują, na przykład Granty lub Kursy."
          }
        }
      }
    },
