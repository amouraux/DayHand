          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가 또는 무언가를 기다리는 할 일이 여기에 나타납니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppgifter som väntar på någon eller något visas här."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgaver, der venter på nogen eller noget, vises her."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppgaver som venter på noen eller noe, vises her."
          }
        },
