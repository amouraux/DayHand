    "Its tasks are kept. They just no longer belong to a project.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Aufgaben bleiben erhalten; sie gehören nur zu keinem Projekt mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus tareas se conservan: simplemente ya no pertenecen a un proyecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses tâches sont conservées : elles n’appartiennent simplement plus à un projet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sue attività restano: semplicemente non appartengono più a un progetto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De taken blijven bestaan; ze horen alleen niet meer bij een project."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas são mantidas: apenas deixam de pertencer a um projeto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクは残ります。プロジェクトに属さなくなるだけです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas são mantidas: apenas deixam de pertencer a um projeto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일은 그대로 유지되며, 더 이상 프로젝트에 속하지 않을 뿐입니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppgifterna behålls. De hör bara inte längre till något projekt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgaverne beholdes. De hører bare ikke længere til et projekt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppgavene beholdes. De hører bare ikke lenger til et prosjekt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehtävät säilyvät. Ne vain eivät enää kuulu projektiin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadania zostają zachowane. Po prostu nie należą już do żadnego projektu."
          }
        }
      }
    },
