    "Each ticked word becomes a project and is removed from the start of those titles. A new project takes the category most of its tasks have.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes angehakte Wort wird ein Projekt und verschwindet vom Anfang dieser Titel. Ein neues Projekt erhält die Kategorie, die die meisten seiner Aufgaben haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada palabra marcada se convierte en un proyecto y desaparece del principio de esos títulos. Un proyecto nuevo toma la categoría que tienen la mayoría de sus tareas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque mot coché devient un projet et disparaît du début de ces titres. Un nouveau projet prend la catégorie majoritaire de ses tâches."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni parola spuntata diventa un progetto e sparisce dall’inizio di quei titoli. Un nuovo progetto prende la categoria della maggior parte delle sue attività."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk aangevinkt woord wordt een project en verdwijnt uit het begin van die titels. Een nieuw project krijgt de categorie die de meeste van zijn taken hebben."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada palavra assinalada torna-se um projeto e desaparece do início desses títulos. Um projeto novo fica com a categoria da maioria das suas tarefas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックを付けた単語がプロジェクトになり、該当するタイトルの先頭から取り除かれます。新しいプロジェクトには、そのタスクの大半が持つカテゴリが付きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada palavra marcada vira um projeto e é removida do início desses títulos. Um projeto novo fica com a categoria da maioria das suas tarefas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체크한 단어는 프로젝트가 되고, 해당 제목의 맨 앞에서 제거됩니다. 새 프로젝트에는 할 일 대부분이 가진 카테고리가 지정됩니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje markerat ord blir ett projekt och tas bort från början av de titlarna. Ett nytt projekt får den kategori som flest av dess uppgifter har."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert afkrydset ord bliver til et projekt og fjernes fra begyndelsen af de titler. Et nyt projekt får den kategori, de fleste af dets opgaver har."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert avmerket ord blir et prosjekt og fjernes fra begynnelsen av disse titlene. Et nytt prosjekt får kategorien de fleste av oppgavene har."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokaisesta valitusta sanasta tulee projekti, ja se poistetaan kyseisten otsikoiden alusta. Uusi projekti saa luokan, joka on useimmilla sen tehtävistä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde zaznaczone słowo staje się projektem i jest usuwane z początku tych tytułów. Nowy projekt otrzymuje kategorię, którą ma większość jego zadań."
          }
        }
      }
    },
