          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져올 메모"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteckningar att importera"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noter, der importeres"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Notater som importeres"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuotavat muistiinpanot"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notatki do zaimportowania"
          }
        }
      }
    },
    "Todoist project CSVs exclude completed tasks. Descriptions, comments and exported metadata are kept in Notes. Subtasks become separate tasks; section and parent context stays in Notes. Labels in titles remain title text. Attachments are not downloaded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Todoist project CSVs exclude completed tasks. Descriptions, comments and exported metadata are kept in Notes. Subtasks become separate tasks; section and parent context stays in Notes. Labels in titles remain title text. Attachments are not downloaded."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les CSV de projet Todoist excluent les tâches terminées. Descriptions, commentaires et métadonnées exportées sont conservés dans Notes. Les sous-tâches deviennent des tâches distinctes ; le contexte des sections et tâches parentes reste dans Notes. Les étiquettes des titres restent du texte dans le titre. Les pièces jointes ne sont pas téléchargées."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Todoist-project-CSV’s bevatten geen voltooide taken. Beschrijvingen, opmerkingen en geëxporteerde metadata blijven in Notities. Subtaken worden aparte taken; sectie- en oudercontext blijft in Notities. Labels in titels blijven titeltekst. Bijlagen worden niet gedownload."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Todoist-Projekt-CSV-Dateien enthalten keine erledigten Aufgaben. Beschreibungen, Kommentare und exportierte Metadaten bleiben in den Notizen. Unteraufgaben werden eigene Aufgaben; Abschnitts- und Elternkontext bleibt in den Notizen. Etiketten in Titeln bleiben Titeltext. Anhänge werden nicht heruntergeladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los CSV de proyectos de Todoist excluyen las tareas completadas. Las descripciones, comentarios y metadatos exportados quedan en Notas. Las subtareas pasan a ser tareas separadas; el contexto de secciones y tareas principales queda en Notas. Las etiquetas en los títulos siguen como texto del título. Los adjuntos no se descargan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I CSV dei progetti Todoist escludono le attività completate. Descrizioni, commenti e metadati esportati restano nelle Note. Le sottoattività diventano attività separate; il contesto di sezioni e attività principali resta nelle Note. Le etichette nei titoli restano testo del titolo. Gli allegati non vengono scaricati."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os CSV de projetos do Todoist excluem tarefas concluídas. Descrições, comentários e metadados exportados ficam nas Notas. As subtarefas tornam-se tarefas separadas; o contexto de secções e tarefas principais fica nas Notas. As etiquetas nos títulos permanecem como texto do título. Os anexos não são descarregados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TodoistのプロジェクトCSVには完了したタスクは含まれません。説明、コメント、書き出されたメタデータはメモに残ります。サブタスクは別々のタスクになり、セクションと親タスクの情報はメモに残ります。タイトル内のラベルはタイトルの文字のままです。添付ファイルはダウンロードされません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os CSVs de projetos do Todoist não incluem tarefas concluídas. Descrições, comentários e metadados exportados ficam em Notas. Subtarefas viram tarefas separadas; o contexto de seção e de tarefa principal fica em Notas. Etiquetas nos títulos continuam como texto do título. Anexos não são baixados."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Todoist 프로젝트 CSV에는 완료된 할 일이 포함되지 않습니다. 설명, 댓글, 내보낸 메타데이터는 메모에 남습니다. 하위 작업은 별도의 할 일이 되며, 섹션과 상위 항목 정보는 메모에 남습니다. 제목의 레이블은 제목 텍스트로 그대로 둡니다. 첨부 파일은 다운로드되지 않습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Todoists projekt-CSV innehåller inte slutförda uppgifter. Beskrivningar, kommentarer och exporterad metadata behålls i Anteckningar. Deluppgifter blir separata uppgifter; avsnitt och överordnad kontext finns kvar i Anteckningar. Etiketter i titlar förblir titeltext. Bilagor laddas inte ned."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Todoists projekt-CSV’er indeholder ikke færdige opgaver. Beskrivelser, kommentarer og eksporterede metadata beholdes i Noter. Delopgaver bliver til separate opgaver; sektion og overordnet kontekst bliver i Noter. Etiketter i titler forbliver titeltekst. Vedhæftninger downloades ikke."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Todoists prosjekt-CSV-er inneholder ikke fullførte oppgaver. Beskrivelser, kommentarer og eksporterte metadata beholdes i Notater. Deloppgaver blir egne oppgaver; seksjon og overordnet kontekst blir i Notater. Etiketter i titler forblir titteltekst. Vedlegg lastes ikke ned."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Todoistin projektien CSV-tiedostoissa ei ole valmiita tehtäviä. Kuvaukset, kommentit ja viedyt metatiedot säilyvät Muistiinpanoissa. Alitehtävistä tulee erillisiä tehtäviä; osio ja ylätehtävä säilyvät Muistiinpanoissa. Otsikoiden tunnisteet pysyvät otsikkotekstinä. Liitteitä ei ladata."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki CSV projektów Todoista nie zawierają ukończonych zadań. Opisy, komentarze i wyeksportowane metadane zostają w Notatkach. Podzadania stają się osobnymi zadaniami; kontekst sekcji i zadania nadrzędnego zostaje w Notatkach. Etykiety w tytułach pozostają tekstem tytułu. Załączniki nie są pobierane."
          }
        }
      }
    },
