    "Nothing left to do, so this project can be put away.": {
      "comment": "Project editor footer",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts mehr zu tun — dieses Projekt kann weggelegt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No queda nada por hacer, así que este proyecto puede guardarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne reste rien à faire : ce projet peut être rangé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non resta nulla da fare, quindi questo progetto può essere riposto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is niets meer te doen, dus dit project kan worden opgeborgen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não falta nada, por isso este projeto pode ser guardado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やることが残っていないので、このプロジェクトはアーカイブできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há mais nada para fazer, então este projeto pode ser arquivado."
          }
        }
      }
    },
