    "Tasks whose reminder has arrived, or arrives within three days, appear here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben, deren Erinnerung eingetroffen ist oder innerhalb von drei Tagen eintrifft, erscheinen hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí aparecen las tareas cuyo recordatorio ha llegado o llegará en los próximos tres días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches dont le rappel est arrivé, ou arrive dans les trois jours, apparaissent ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui compaiono le attività il cui promemoria è arrivato o arriva entro tre giorni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taken waarvan de herinnering is aangekomen, of binnen drie dagen aankomt, verschijnen hier."
