    "Review your tasks one at a time. You can stop and resume whenever you like.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examinez vos tâches une à une. Vous pouvez arrêter et reprendre à tout moment."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk je taken één voor één. Je kunt altijd stoppen en verdergaan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh deine Aufgaben einzeln durch. Du kannst jederzeit aufhören und fortfahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa tus tareas una por una. Puedes parar y continuar cuando quieras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rivedi le attività una alla volta. Puoi interrompere e riprendere quando vuoi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reveja as tarefas uma de cada vez. Pode parar e retomar quando quiser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクを1つずつレビューします。いつでも中断して、再開できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise as tarefas uma de cada vez. Você pode parar e retomar quando quiser."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일을 하나씩 검토하세요. 언제든 멈췄다가 다시 시작할 수 있습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Granska dina uppgifter en i taget. Du kan sluta och återuppta när du vill."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gennemgå dine opgaver én ad gangen. Du kan stoppe og genoptage, når du vil."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå gjennom oppgavene dine én om gangen. Du kan stoppe og fortsette når du vil."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käy tehtäväsi läpi yksi kerrallaan. Voit pysähtyä ja jatkaa milloin haluat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeglądaj zadania po kolei. Możesz przerwać i wrócić, kiedy chcesz."
          }
        }
      }
    },
