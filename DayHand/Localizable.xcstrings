    "Everything you have stays yours either way: your tasks, backups and exports always hold all of it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In jedem Fall bleibt alles deins: Deine Aufgaben, Sicherungen und Exporte enthalten immer alles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo tuyo sigue siendo tuyo en cualquier caso: tus tareas, copias de seguridad y exportaciones siempre lo contienen todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans tous les cas, tout reste à vous : vos tâches, sauvegardes et exports contiennent toujours tout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In ogni caso tutto resta tuo: le attività, i backup e le esportazioni contengono sempre tutto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe dan ook blijft alles van jou: je taken, back-ups en exports bevatten altijd alles."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em qualquer dos casos, tudo continua a ser seu: as tarefas, as cópias de segurança e as exportações contêm sempre tudo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
