    "Task review finished. Return to the project overview to decide whether it has a clear way forward.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Révision des tâches terminée. Revenez à la vue du projet pour décider si la suite est claire."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taken doorgenomen. Ga terug naar het projectoverzicht om te bepalen of de volgende stap duidelijk is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben durchgesehen. Kehre zur Projektübersicht zurück, um zu prüfen, ob der nächste Schritt klar ist."
          }
        },
        "es": {
