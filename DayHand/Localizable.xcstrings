    "Review your tasks one at a time. You can stop and resume whenever you like." : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gennemgå dine opgaver én ad gangen. Du kan stoppe og genoptage, når du vil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh deine Aufgaben einzeln durch. Du kannst jederzeit aufhören und fortfahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa tus tareas una por una. Puedes parar y continuar cuando quieras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käy tehtäväsi läpi yksi kerrallaan. Voit pysähtyä ja jatkaa milloin haluat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Examinez vos tâches une à une. Vous pouvez arrêter et reprendre à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rivedi le attività una alla volta. Puoi interrompere e riprendere quando vuoi."
