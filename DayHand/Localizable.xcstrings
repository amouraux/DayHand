          }
        }
      }
    },
    "This is a one-time copy. Later changes in either app are independent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a one-time copy. Later changes in either app are independent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s’agit d’une copie unique. Les modifications ultérieures dans chaque app sont indépendantes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een eenmalige kopie. Latere wijzigingen in beide apps staan los van elkaar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist eine einmalige Kopie. Spätere Änderungen in den beiden Apps sind unabhängig voneinander."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es una copia única. Los cambios posteriores en cada app son independientes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È una copia unica. Le modifiche successive nelle due app sono indipendenti."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma cópia única. As alterações posteriores em cada app são independentes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは1回限りのコピーです。以降の変更は、それぞれのAppで独立します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma cópia única. As alterações posteriores em cada app são independentes."
          }
        }
      }
    },
    "An import destination changed. Go back and choose it again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An import destination changed. Go back and choose it again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une destination d’import a changé. Revenez en arrière et choisissez-la à nouveau."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een importbestemming is gewijzigd. Ga terug en kies deze opnieuw."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Importziel wurde geändert. Gehe zurück und wähle es erneut aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha cambiado un destino de importación. Vuelve atrás y elígelo de nuevo."
