            "value" : "「%@」というプロジェクトはすでにあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 프로젝트가 이미 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et prosjekt som heter %@ finnes allerede."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er bestaat al een project met de naam %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekt o nazwie %@ już istnieje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
