        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pełny przegląd zakończony. Zadania, które zostawiono, pozostają w swoich stosach. Nowe zadania można przejrzeć w następnym przebiegu."
          }
