          "stringUnit": {
            "state": "translated",
            "value": "Le attività in corso restano in Adesso. Le nuove saranno incluse nella prossima revisione."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas em curso permanecem em Agora. As novas serão incluídas na próxima revisão."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ取り組んでいるタスクは「今」に残ります。新しく届いたタスクは、次回のレビューに含まれます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas em que você ainda está trabalhando permanecem em Agora. As novas entram na sua próxima revisão."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 하고 있는 할 일은 ‘지금’에 남습니다. 새로 도착한 할 일은 다음 검토에 포함됩니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppgifter du fortfarande arbetar med stannar i Nu. Nya uppgifter tas med i nästa granskning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgaver, du stadig arbejder på, bliver i Nu. Nye opgaver tages med i din næste gennemgang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppgaver du fortsatt jobber med, blir i Nå. Nye oppgaver tas med i neste gjennomgang."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehtävät, joita teet yhä, pysyvät kohdassa Nyt. Uudet tehtävät otetaan mukaan seuraavaan läpikäyntiin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadania, nad którymi nadal pracujesz, zostają w sekcji Teraz. Nowe zadania zostaną uwzględnione w następnym przeglądzie."
          }
        }
      }
    },
