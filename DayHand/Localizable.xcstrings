    "Allow Reminders access in system settings, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Reminders access in system settings, then try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès aux rappels dans les réglages système, puis réessayez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta toegang tot Herinneringen toe in de systeeminstellingen en probeer het opnieuw."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Zugriff auf Erinnerungen in den Systemeinstellungen und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a Recordatorios en los ajustes del sistema y vuelve a intentarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso ai promemoria nelle impostazioni di sistema, poi riprova."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso aos Lembretes nas definições do sistema e tente novamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定でリマインダーへのアクセスを許可してから、もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso aos Lembretes nos ajustes do sistema e tente novamente."
          }
        }
      }
    },
    "Reminders could not be read. Please try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders could not be read. Please try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels n’ont pas pu être lus. Réessayez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De herinneringen konden niet worden gelezen. Probeer het opnieuw."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erinnerungen konnten nicht gelesen werden. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
