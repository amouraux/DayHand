    "Put one file in iCloud Drive and point every device at it. iCloud syncs the file, so no paid developer account is needed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie eine Datei in iCloud Drive und richten Sie jedes Gerät darauf aus. iCloud synchronisiert die Datei, ein bezahlter Entwickleraccount ist nicht nötig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon un archivo en iCloud Drive y apunta ahí cada dispositivo. iCloud sincroniza el archivo, así que no hace falta una cuenta de desarrollador de pago."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez un fichier dans iCloud Drive et pointez chaque appareil dessus. iCloud synchronise le fichier : aucun compte développeur payant n’est nécessaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti un file in iCloud Drive e fai puntare lì ogni dispositivo. iCloud sincronizza il file, quindi non serve un account sviluppatore a pagamento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet één bestand in iCloud Drive en laat elk apparaat ernaar wijzen. iCloud synchroniseert het bestand, dus een betaald ontwikkelaarsaccount is niet nodig."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque um ficheiro no iCloud Drive e aponte cada dispositivo para ele. O iCloud sincroniza o ficheiro, pelo que não é preciso uma conta de programador paga."
          }
        }
      }
    },
