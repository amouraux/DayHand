          "stringUnit": {
            "state": "translated",
            "value": "Rien ne bascule : les tâches restent où vous les mettez"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente slitta: le attività restano dove le metti"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets schuift door: taken blijven waar je ze zet"
          }
        },
        "pt-PT": {
