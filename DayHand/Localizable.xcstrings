    "Task review finished. Return to the project overview to decide whether it has a clear way forward." : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gennemgangen af opgaver er færdig. Gå tilbage til projektoversigten for at afgøre, om der er en klar vej frem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufgaben durchgesehen. Kehre zur Projektübersicht zurück, um zu prüfen, ob der nächste Schritt klar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisión terminada. Vuelve al resumen del proyecto para decidir si el siguiente paso está claro."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tehtävien läpikäynti on valmis. Palaa projektin yleiskatsaukseen ja päätä, onko eteenpäin selvä tie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Révision des tâches terminée. Revenez à la vue du projet pour décider si la suite est claire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisione terminata. Torna alla panoramica del progetto per decidere se il prossimo passo è chiaro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タスクのレビューが完了しました。プロジェクトの概要に戻り、進め方がはっきりしているか確認しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "할 일 검토를 마쳤습니다. 프로젝트 개요로 돌아가 앞으로의 방향이 분명한지 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjennomgangen av oppgaver er ferdig. Gå tilbake til prosjektoversikten for å avgjøre om det er en tydelig vei videre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taken doorgenomen. Ga terug naar het projectoverzicht om te bepalen of de volgende stap duidelijk is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przegląd zadań zakończony. Wróć do przeglądu projektu, aby zdecydować, czy ma jasną drogę naprzód."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisão das tarefas concluída. Volte à visão geral do projeto para decidir se o caminho a seguir está claro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
